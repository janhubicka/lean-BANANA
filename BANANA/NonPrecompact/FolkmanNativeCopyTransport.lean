import BANANA.NonPrecompact.FolkmanNativeFiniteCodeRealisation
import BANANA.NonPrecompact.FolkmanNativePairingEmbedding

/-!
# Transport of the Folkman persistent colouring to native copies

An `A_folk` copy is specified by its two nonzero generators, whose pairing
is one. Its two carriers are the two-element subrings generated by those
elements. Finite atom supports identify these copies with the copies in
the atom model. Containment in a native target is containment of the
two generators in the ranges of the two ring maps.
-/

namespace SuccessorTree.NonPrecompact

open scoped Classical symmDiff

/-- The two native generators of a copy of the one-atom pairing
with pairing value one. -/
structure FolkmanNativeAxCopy {L R : Type*} [BooleanRing L] [BooleanRing R]
    (P : FolkmanNativeFinitePairing L R) where
  left : L
  right : R
  pairing_one : P.pairing left right = 1

namespace FolkmanNativeAxCopy

variable {L R : Type*} [BooleanRing L] [BooleanRing R]
variable {P : FolkmanNativeFinitePairing L R}

theorem left_ne_zero (X : FolkmanNativeAxCopy P) : X.left ≠ 0 := by
  intro hx
  have hp : P.pairing 0 X.right = 1 := by simpa only [hx] using X.pairing_one
  have h := P.add_left 0 0 X.right
  simp only [add_zero, hp] at h
  exact one_ne_zero (h.trans (by decide))

theorem right_ne_zero (X : FolkmanNativeAxCopy P) : X.right ≠ 0 := by
  intro hx
  have hp : P.pairing X.left 0 = 1 := by simpa only [hx] using X.pairing_one
  have h := P.add_right X.left 0 0
  simp only [add_zero, hp] at h
  exact one_ne_zero (h.trans (by decide))

/-- Both two-element carriers lie in the target ranges exactly when
both generators do, since each ring map sends zero to zero. -/
theorem inside_iff_generator_ranges
    {BL BR : Type*} [BooleanRing BL] [BooleanRing BR]
    {B : FolkmanNativeFinitePairing BL BR}
    (X : FolkmanNativeAxCopy P) (f : FolkmanNativePairingEmbedding B P) :
    ({0, X.left} : Set L) ⊆ Set.range f.left ∧
      ({0, X.right} : Set R) ⊆ Set.range f.right ↔
      X.left ∈ Set.range f.left ∧ X.right ∈ Set.range f.right := by
  constructor
  · rintro ⟨hL, hR⟩
    exact ⟨hL (by simp), hR (by simp)⟩
  · rintro ⟨hL, hR⟩
    constructor
    · intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl
      · exact ⟨0, map_zero f.left⟩
      · exact hL
    · intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl
      · exact ⟨0, map_zero f.right⟩
      · exact hR

variable [Fintype L] [Fintype R]

/-- Native pairing is the parity of the ordinary incidence count
on the two atom supports. -/
theorem edgeCount_cast (P : FolkmanNativeFinitePairing L R) (x : L) (y : R) :
    (folkmanEdgeCount P.finiteAtomCode.edge
        (folkmanNativeFinSupport L x) (folkmanNativeFinSupport R y) : F2) =
      P.pairing x y :=
  (folkmanNativeFin_edgeCount_cast P.finiteAtomCode _ _).trans
    (P.finiteAtomCode_pairing x y).symm

/-- Encode both original generators by their finite atom supports. -/
noncomputable def toAtomCode (X : FolkmanNativeAxCopy P) :
    FolkmanAxCopy P.finiteAtomCode where
  leftBlock := folkmanNativeFinSupport L X.left
  rightBlock := folkmanNativeFinSupport R X.right
  left_nonempty := by
    apply Finset.nonempty_iff_ne_empty.mpr
    intro h
    apply X.left_ne_zero
    apply (folkmanNativeFiniteRingCodeEquiv L).injective
    exact h.trans (folkmanNativeFiniteRingCode_zero L).symm
  right_nonempty := by
    apply Finset.nonempty_iff_ne_empty.mpr
    intro h
    apply X.right_ne_zero
    apply (folkmanNativeFiniteRingCodeEquiv R).injective
    exact h.trans (folkmanNativeFiniteRingCode_zero R).symm
  edgeCount_odd :=
    ZMod.natCast_eq_one_iff_odd.mp ((edgeCount_cast P X.left X.right).trans X.pairing_one)

/-- Decode two atom blocks to the original generators. -/
noncomputable def ofAtomCode (X : FolkmanAxCopy P.finiteAtomCode) :
    FolkmanNativeAxCopy P where
  left := (folkmanNativeFiniteRingCodeEquiv L).symm X.leftBlock
  right := (folkmanNativeFiniteRingCodeEquiv R).symm X.rightBlock
  pairing_one := by
    let eL := folkmanNativeFiniteRingCodeEquiv L
    let eR := folkmanNativeFiniteRingCodeEquiv R
    calc
      P.pairing (eL.symm X.leftBlock) (eR.symm X.rightBlock) =
          (folkmanEdgeCount P.finiteAtomCode.edge
            (eL (eL.symm X.leftBlock)) (eR (eR.symm X.rightBlock)) : F2) :=
        (edgeCount_cast P _ _).symm
      _ = (folkmanEdgeCount P.finiteAtomCode.edge X.leftBlock X.rightBlock : F2) :=
        congrArg₂ (fun s t => (folkmanEdgeCount P.finiteAtomCode.edge s t : F2))
          (eL.apply_symm_apply X.leftBlock) (eR.apply_symm_apply X.rightBlock)
      _ = 1 := ZMod.natCast_eq_one_iff_odd.mpr X.edgeCount_odd

private theorem atomCopy_ext {C : FolkmanAtomStructure}
    {X Y : FolkmanAxCopy C}
    (hL : X.leftBlock = Y.leftBlock)
    (hR : X.rightBlock = Y.rightBlock) : X = Y := by
  cases X
  cases Y
  dsimp at hL hR
  cases hL
  cases hR
  rfl

/-- Native copies and atom-code copies are in bijection. -/
noncomputable def equivAtomCode (P : FolkmanNativeFinitePairing L R) :
    FolkmanNativeAxCopy P ≃ FolkmanAxCopy P.finiteAtomCode where
  toFun := toAtomCode
  invFun := ofAtomCode
  left_inv := by
    rintro ⟨x, y, h⟩
    simp [ofAtomCode, toAtomCode, folkmanNativeFinSupport]
  right_inv := by
    intro X
    exact atomCopy_ext ((folkmanNativeFiniteRingCodeEquiv L).apply_symm_apply X.leftBlock)
      ((folkmanNativeFiniteRingCodeEquiv R).apply_symm_apply X.rightBlock)

end FolkmanNativeAxCopy

section RealisedTarget

variable {L R : Type*} [BooleanRing L] [Fintype L] [BooleanRing R] [Fintype R]

private noncomputable def realisedMap
    {n : ℕ} (f : FolkmanNativeCodeRing n →ₙ+* L) (s : Finset (Fin n)) :
    Finset (Fin (Fintype.card (PrebananaAbstractAtoms (AsBoolAlg L)))) :=
  folkmanNativeFinSupport L (f (toBoolRing s))

private theorem realisedMap_exists_owner
    {n : ℕ} (f : FolkmanNativeCodeRing n →ₙ+* L) (hf : Function.Injective f) :
    ∃ owner : Fin (Fintype.card (PrebananaAbstractAtoms (AsBoolAlg L))) →
        Option (Fin n),
      (∀ i, ∃ j, owner j = some i) ∧
      (∀ s, realisedMap f s = s.biUnion (folkmanFiber owner)) := by
  have h0 : realisedMap f ∅ = ∅ := by
    change folkmanNativeFinSupport L (f 0) = ∅
    rw [map_zero]
    exact folkmanNativeFiniteRingCode_zero L
  have hadd (s t : Finset (Fin n)) :
      realisedMap f (symmDiff s t) = symmDiff (realisedMap f s) (realisedMap f t) := by
    change folkmanNativeFiniteRingCodeEquiv L (f (toBoolRing s + toBoolRing t)) =
      symmDiff _ _
    rw [map_add, folkmanNativeFiniteRingCode_add]
    rfl
  have hmul (s t : Finset (Fin n)) :
      realisedMap f (s ∩ t) = realisedMap f s ∩ realisedMap f t := by
    change folkmanNativeFiniteRingCodeEquiv L (f (toBoolRing s * toBoolRing t)) =
      _ ∩ _
    rw [map_mul, folkmanNativeFiniteRingCode_mul]
    rfl
  have hinj : Function.Injective (realisedMap f) :=
    (folkmanNativeFiniteRingCodeEquiv L).injective.comp (hf.comp toBoolRing.injective)
  obtain ⟨owner, honto, hmap⟩ :=
    folkman_exists_partialOwner_of_ringEmbedding (realisedMap f) h0 hadd hmul hinj
  refine ⟨owner, honto, fun s => ?_⟩
  rw [hmap]
  ext i
  simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_biUnion, folkmanFiber]

/-- An embedding of the native realisation of an atom matrix gives an
atom embedding with exactly the same maps on both original carriers. -/
theorem folkmanNativeRealisation_atomEmbedding
    (A : FolkmanAtomStructure) (P : FolkmanNativeFinitePairing L R)
    (f : FolkmanNativePairingEmbedding (folkmanNativeCodeRealisation A) P) :
    ∃ E : FolkmanAtomEmbedding A P.finiteAtomCode,
      (∀ s : Finset (Fin A.leftCount),
        folkmanNativeFinSupport L (f.left (toBoolRing s)) =
          s.biUnion (folkmanFiber E.leftOwner)) ∧
      (∀ t : Finset (Fin A.rightCount),
        folkmanNativeFinSupport R (f.right (toBoolRing t)) =
          t.biUnion (folkmanFiber E.rightOwner)) := by
  obtain ⟨ownerL, hontoL, hmapL⟩ := realisedMap_exists_owner f.left f.left_injective
  obtain ⟨ownerR, hontoR, hmapR⟩ := realisedMap_exists_owner f.right f.right_injective
  let E : FolkmanAtomEmbedding A P.finiteAtomCode :=
    { leftOwner := ownerL
      rightOwner := ownerR
      left_fibre_nonempty := fun i => folkmanNativeFin_fibre_nonempty ownerL i (hontoL i)
      right_fibre_nonempty := fun j => folkmanNativeFin_fibre_nonempty ownerR j (hontoR j)
      pairing_parity := by
        intro i j
        have hL : folkmanNativeFinSupport L (f.left (toBoolRing {i})) =
            folkmanFiber ownerL i := by
          simpa only [realisedMap, Finset.singleton_biUnion] using hmapL {i}
        have hR : folkmanNativeFinSupport R (f.right (toBoolRing {j})) =
            folkmanFiber ownerR j := by
          simpa only [realisedMap, Finset.singleton_biUnion] using hmapR {j}
        calc
          (folkmanEdgeCount P.finiteAtomCode.edge
              (folkmanFiber ownerL i) (folkmanFiber ownerR j) : F2) =
              (folkmanEdgeCount P.finiteAtomCode.edge
                (folkmanNativeFinSupport L (f.left (toBoolRing {i})))
                (folkmanNativeFinSupport R (f.right (toBoolRing {j}))) : F2) :=
            congrArg₂ (fun s t => (folkmanEdgeCount P.finiteAtomCode.edge s t : F2))
              hL.symm hR.symm
          _ = P.pairing (f.left (toBoolRing {i})) (f.right (toBoolRing {j})) :=
            FolkmanNativeAxCopy.edgeCount_cast P _ _
          _ = (folkmanNativeCodeRealisation A).pairing (toBoolRing {i}) (toBoolRing {j}) :=
            f.preserves_pairing _ _
          _ = A.edge i j := folkmanNativeCodeRealisation_singletons A i j }
  exact ⟨E, hmapL, hmapR⟩

/-- The persistent colouring exists on the original rings, and every
embedding of the native diagonal realisation sees all colours inside
its actual left and right ring ranges. -/
theorem exists_folkmanNativePersistentColouring
    (k : ℕ) (P : FolkmanNativeFinitePairing L R) :
    ∃ colour : FolkmanNativeAxCopy P → Fin (2 ^ k),
      ∀ f : FolkmanNativePairingEmbedding
          (folkmanNativeCodeRealisation
            (FolkmanAtomStructure.diagonal (2 ^ (k + 1)))) P,
        ∀ c : Fin (2 ^ k), ∃ X : FolkmanNativeAxCopy P,
          ({0, X.left} : Set L) ⊆ Set.range f.left ∧
          ({0, X.right} : Set R) ⊆ Set.range f.right ∧
          colour X = c := by
  obtain ⟨colour, hcolour⟩ := exists_folkmanPersistentColouring k P.finiteAtomCode
  let e := FolkmanNativeAxCopy.equivAtomCode P
  refine ⟨fun X => colour (e X), ?_⟩
  intro f c
  obtain ⟨E, hmapL, hmapR⟩ := folkmanNativeRealisation_atomEmbedding _ P f
  obtain ⟨Y, ⟨s, t, hs, ht⟩, hc⟩ := hcolour E c
  let X := e.symm Y
  have hXL : X.left ∈ Set.range f.left := by
    refine ⟨toBoolRing s, ?_⟩
    apply (folkmanNativeFiniteRingCodeEquiv L).injective
    exact (hmapL s).trans (hs.symm.trans
      ((folkmanNativeFiniteRingCodeEquiv L).apply_symm_apply Y.leftBlock).symm)
  have hXR : X.right ∈ Set.range f.right := by
    refine ⟨toBoolRing t, ?_⟩
    apply (folkmanNativeFiniteRingCodeEquiv R).injective
    exact (hmapR t).trans (ht.symm.trans
      ((folkmanNativeFiniteRingCodeEquiv R).apply_symm_apply Y.rightBlock).symm)
  obtain ⟨hL, hR⟩ := (X.inside_iff_generator_ranges f).mpr ⟨hXL, hXR⟩
  exact ⟨X, hL, hR, (congrArg colour (e.apply_symm_apply Y)).trans hc⟩

/-- Every proposed native bound `t` fails. For the diagonal target
of size `2^(t+1)` and `2^t` colours, no native ambient structure is a
Ramsey witness for that bound. -/
theorem folkmanNativeAxCopy_not_bounded
    (t : ℕ) (P : FolkmanNativeFinitePairing L R) :
    ¬ ∀ colour : FolkmanNativeAxCopy P → Fin (2 ^ t),
      ∃ f : FolkmanNativePairingEmbedding
          (folkmanNativeCodeRealisation
            (FolkmanAtomStructure.diagonal (2 ^ (t + 1)))) P,
        ∃ colours : Finset (Fin (2 ^ t)),
          colours.card ≤ t ∧
          ∀ X : FolkmanNativeAxCopy P,
            ({0, X.left} : Set L) ⊆ Set.range f.left →
            ({0, X.right} : Set R) ⊆ Set.range f.right →
            colour X ∈ colours := by
  intro h
  obtain ⟨colour, hpersist⟩ := exists_folkmanNativePersistentColouring t P
  obtain ⟨f, colours, hcard, hcover⟩ := h colour
  have hall : (Finset.univ : Finset (Fin (2 ^ t))) ⊆ colours := by
    intro c _
    obtain ⟨X, hL, hR, hcolour⟩ := hpersist f c
    rw [← hcolour]
    exact hcover X hL hR
  have hle := (Finset.card_le_card hall).trans hcard
  exact (Nat.not_le_of_gt t.lt_two_pow_self) (by simpa using hle)

end RealisedTarget

end SuccessorTree.NonPrecompact
