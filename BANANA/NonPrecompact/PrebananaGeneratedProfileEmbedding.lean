import BANANA.NonPrecompact.PrebananaActualGeneratedBooleanOps
import BANANA.NonPrecompact.PrebananaFiniteBooleanModelHeredity

/-!
# Exact marked embeddings between tuple-generated finite Boolean subalgebras

Equal complete marked profiles of tuples from two finite pre-BANANA
models yield a bijection between the Boolean algebras generated by the
tuples. The existing term-value development proves that this map
preserves each Boolean operation and the F₂ marking.

Here we package those results into a **genuine marked finite Boolean
embedding**, rather than a bare equivalence of term values. This is
the reusable bridge needed to transfer profile equality to a global
automorphism of the countable pre-BANANA limit.

No homogeneity or Fraïssé-limit assumption is used.
-/

namespace SuccessorTree.NonPrecompact

open scoped Classical

/-- Equality of the complete marked profiles gives a true
marking-preserving Boolean embedding between the two finite
tuple-generated subalgebras. Its carrier map is bijective. -/
noncomputable def prebananaFiniteGeneratedMarkedEmbedding_of_profile_eq
    {n : ℕ} (A B : PrebananaFiniteBooleanModel)
    (tupleA : Fin n → A.carrier)
    (tupleB : Fin n → B.carrier)
    (hprofile :
      prebananaAbstractMarkedTupleProfile
        A.carrier A.μ A.μ_bot A.μ_top A.μ_add tupleA =
      prebananaAbstractMarkedTupleProfile
        B.carrier B.μ B.μ_bot B.μ_top B.μ_add tupleB) :
    PrebananaFiniteBooleanEmbedding
      (prebananaFiniteBooleanSubmodel A
        (prebananaGeneratedBooleanSubalgebra A.carrier tupleA))
      (prebananaFiniteBooleanSubmodel B
        (prebananaGeneratedBooleanSubalgebra B.carrier tupleB)) := by
  classical
  let e : PrebananaAbstractGeneratedMarkedIso
      A.carrier B.carrier tupleA tupleB A.μ B.μ :=
    prebananaAbstractGeneratedMarkedIso_of_profile_eq
      A.carrier B.carrier A.μ B.μ
      A.μ_bot A.μ_top A.μ_add
      B.μ_bot B.μ_top B.μ_add
      tupleA tupleB hprofile
  exact {
    hom := {
      toFun := e.toGeneratedEquiv
      map_bot' := e.toGeneratedEquiv_map_bot
      map_top' := e.toGeneratedEquiv_map_top
      map_sup' := e.toGeneratedEquiv_map_sup
      map_inf' := e.toGeneratedEquiv_map_inf
    }
    injective := e.toGeneratedEquiv.injective
    preserves_μ := e.toGeneratedEquiv_preserves_mark
  }

/-- The induced map on generated Boolean subalgebras is
surjective, not merely injective. -/
theorem prebananaFiniteGeneratedMarkedEmbedding_surjective
    {n : ℕ} (A B : PrebananaFiniteBooleanModel)
    (tupleA : Fin n → A.carrier)
    (tupleB : Fin n → B.carrier)
    (hprofile :
      prebananaAbstractMarkedTupleProfile
        A.carrier A.μ A.μ_bot A.μ_top A.μ_add tupleA =
      prebananaAbstractMarkedTupleProfile
        B.carrier B.μ B.μ_bot B.μ_top B.μ_add tupleB) :
    Function.Surjective
      (prebananaFiniteGeneratedMarkedEmbedding_of_profile_eq
        A B tupleA tupleB hprofile).hom := by
  classical
  let e : PrebananaAbstractGeneratedMarkedIso
      A.carrier B.carrier tupleA tupleB A.μ B.μ :=
    prebananaAbstractGeneratedMarkedIso_of_profile_eq
      A.carrier B.carrier A.μ B.μ
      A.μ_bot A.μ_top A.μ_add
      B.μ_bot B.μ_top B.μ_add
      tupleA tupleB hprofile
  change Function.Surjective e.toGeneratedEquiv
  exact e.toGeneratedEquiv.surjective

/-- The embedding induced by equal marked tuple profiles carries
each distinguished generator to the corresponding target generator.
This equality is on the original finite Boolean-algebra carriers,
not merely on abstract term symbols. -/
theorem prebananaFiniteGeneratedMarkedEmbedding_map_generator
    {n : ℕ} (A B : PrebananaFiniteBooleanModel)
    (tupleA : Fin n → A.carrier)
    (tupleB : Fin n → B.carrier)
    (hprofile :
      prebananaAbstractMarkedTupleProfile
        A.carrier A.μ A.μ_bot A.μ_top A.μ_add tupleA =
      prebananaAbstractMarkedTupleProfile
        B.carrier B.μ B.μ_bot B.μ_top B.μ_add tupleB)
    (i : Fin n) :
    ((prebananaFiniteGeneratedMarkedEmbedding_of_profile_eq
      A B tupleA tupleB hprofile).hom
      (⟨tupleA i,
        BooleanSubalgebra.subset_closure (Set.mem_range_self i)⟩ :
        (prebananaFiniteBooleanSubmodel A
          (prebananaGeneratedBooleanSubalgebra A.carrier tupleA)).carrier)).val =
      tupleB i := by
  classical
  let e : PrebananaAbstractGeneratedMarkedIso
      A.carrier B.carrier tupleA tupleB A.μ B.μ :=
    prebananaAbstractGeneratedMarkedIso_of_profile_eq
      A.carrier B.carrier A.μ B.μ
      A.μ_bot A.μ_top A.μ_add
      B.μ_bot B.μ_top B.μ_add
      tupleA tupleB hprofile
  change (e.toGeneratedEquiv
    (⟨tupleA i,
      BooleanSubalgebra.subset_closure (Set.mem_range_self i)⟩ :
      prebananaGeneratedBooleanSubalgebra A.carrier tupleA)).val =
    tupleB i
  simpa only [PrebananaBooleanTerm.evalBoolean] using
    (e.toGeneratedEquiv_map_term (.generator i))

end SuccessorTree.NonPrecompact
