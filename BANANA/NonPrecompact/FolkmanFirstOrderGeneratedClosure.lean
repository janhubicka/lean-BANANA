import BANANA.NonPrecompact.FolkmanFirstOrderSubstructureConverse

/-!
# Generated first-order Folkman substructures equal generated ring pairs

For finite Boolean-ring carriers, the closure of a finite tagged tuple
under the two named zeros and four totalised ring operations is
EXACTLY the tagged union of the two original non-unital subrings
generated by its left and right coordinates.

The first inclusion is immediate because the union of those
subrings is closed under the first-order functions. For the
reverse inclusion, intersect the first-order closure with the two
original sorts and apply the universal property of non-unital
ring closure. Additive inverses are recovered from the Boolean
identity -x = x, without naming a unit.

The empty tuple case is included: two distinct named zero
constants belong to the first-order closure.
No countable limit or homogeneity is assumed.
-/

namespace SuccessorTree.NonPrecompact

open scoped FirstOrder

/-- The tagged set of generators of one pair of tuples.
These are the actual original elements, not atom labels. -/
def folkmanTaggedGenerators
    {L R : Type*} {nL nR : ℕ}
    (xs : Fin nL → L) (ys : Fin nR → R) :
    Set (Sum L R) :=
  Set.range (fun i => Sum.inl (xs i)) ∪
    Set.range (fun j => Sum.inr (ys j))

/-- The first-order closure is contained in the tagged union of
the two original generated non-unital subrings. This direction
does NOT require a BooleanRing instance: both generated subrings
are already closed under all named first-order functions. -/
theorem folkmanTaggedClosure_le_generated
    {L R : Type*} [NonUnitalRing L] [NonUnitalRing R]
    (β : L → R → F2)
    {nL nR : ℕ}
    (xs : Fin nL → L) (ys : Fin nR → R) :
    letI : folkmanFirstOrderLanguage.Structure (Sum L R) :=
      folkmanTaggedFirstOrderStructure L R β
    FirstOrder.Language.Substructure.closure folkmanFirstOrderLanguage
        (folkmanTaggedGenerators xs ys) ≤
      folkmanTaggedSubstructure β
        (NonUnitalSubring.closure (Set.range xs))
        (NonUnitalSubring.closure (Set.range ys)) := by
  letI : folkmanFirstOrderLanguage.Structure (Sum L R) :=
    folkmanTaggedFirstOrderStructure L R β
  apply FirstOrder.Language.Substructure.closure_le.mpr
  intro z hz
  rcases hz with ⟨i, rfl⟩ | ⟨j, rfl⟩
  · change xs i ∈ NonUnitalSubring.closure (Set.range xs)
    exact NonUnitalSubring.subset_closure (Set.mem_range_self i)
  · change ys j ∈ NonUnitalSubring.closure (Set.range ys)
    exact NonUnitalSubring.subset_closure (Set.mem_range_self j)

/-- For Boolean-ring carriers the opposite inclusion also holds:
a tagged first-order closure already contains every element
generated by the original non-unital ring operations. -/
theorem folkmanTaggedGenerated_le_closure
    {L R : Type*} [BooleanRing L] [BooleanRing R]
    (β : L → R → F2)
    {nL nR : ℕ}
    (xs : Fin nL → L) (ys : Fin nR → R) :
    letI : folkmanFirstOrderLanguage.Structure (Sum L R) :=
      folkmanTaggedFirstOrderStructure L R β
    folkmanTaggedSubstructure β
        (NonUnitalSubring.closure (Set.range xs))
        (NonUnitalSubring.closure (Set.range ys)) ≤
      FirstOrder.Language.Substructure.closure folkmanFirstOrderLanguage
        (folkmanTaggedGenerators xs ys) := by
  letI : folkmanFirstOrderLanguage.Structure (Sum L R) :=
    folkmanTaggedFirstOrderStructure L R β
  let S : folkmanFirstOrderLanguage.Substructure (Sum L R) :=
    FirstOrder.Language.Substructure.closure
      folkmanFirstOrderLanguage (folkmanTaggedGenerators xs ys)
  have hleft :
      NonUnitalSubring.closure (Set.range xs) ≤
        folkmanLeftSubringOfFirstOrder β S := by
    apply NonUnitalSubring.closure_le.mpr
    intro x hx
    obtain ⟨i, rfl⟩ := hx
    change (Sum.inl (xs i) : Sum L R) ∈ S
    exact FirstOrder.Language.Substructure.subset_closure
      (Or.inl ⟨i, rfl⟩)
  have hright :
      NonUnitalSubring.closure (Set.range ys) ≤
        folkmanRightSubringOfFirstOrder β S := by
    apply NonUnitalSubring.closure_le.mpr
    intro y hy
    obtain ⟨j, rfl⟩ := hy
    change (Sum.inr (ys j) : Sum L R) ∈ S
    exact FirstOrder.Language.Substructure.subset_closure
      (Or.inr ⟨j, rfl⟩)
  intro z hz
  cases z with
  | inl x =>
      change x ∈ NonUnitalSubring.closure (Set.range xs) at hz
      exact hleft hz
  | inr y =>
      change y ∈ NonUnitalSubring.closure (Set.range ys) at hz
      exact hright hz

/-- Exact generated-structure correspondence in the original
language: the tagged first-order closure of both tuples is
precisely the union of their two non-unital generated ring
substructures. This includes zero rings and empty tuples. -/
theorem folkmanTaggedClosure_eq_generated
    {L R : Type*} [BooleanRing L] [BooleanRing R]
    (β : L → R → F2)
    {nL nR : ℕ}
    (xs : Fin nL → L) (ys : Fin nR → R) :
    letI : folkmanFirstOrderLanguage.Structure (Sum L R) :=
      folkmanTaggedFirstOrderStructure L R β
    FirstOrder.Language.Substructure.closure folkmanFirstOrderLanguage
        (folkmanTaggedGenerators xs ys) =
      folkmanTaggedSubstructure β
        (NonUnitalSubring.closure (Set.range xs))
        (NonUnitalSubring.closure (Set.range ys)) := by
  letI : folkmanFirstOrderLanguage.Structure (Sum L R) :=
    folkmanTaggedFirstOrderStructure L R β
  apply le_antisymm
  · exact folkmanTaggedClosure_le_generated β xs ys
  · exact folkmanTaggedGenerated_le_closure β xs ys

end SuccessorTree.NonPrecompact
