import BANANA.NonPrecompact.PrebananaActualGeneratedBooleanOps

/-!
# A marked bounded-lattice embedding of actual generated pre-BANANA subalgebras

The preceding finite-algebra proofs construct an equivalence on actual
Mathlib Boolean subalgebras generated by tuples and verify its preservation
of zero, unit, joins, meets, complements and the F₂ marking.

This file packages the equivalence as an injective, surjective bounded
lattice homomorphism, preserving marks and distinguished generators.
The infinite Fraïssé-limit automorphism extension is not claimed.
-/

namespace SuccessorTree.NonPrecompact

variable {n : ℕ} {α β : Type*}
variable [BooleanAlgebra α] [BooleanAlgebra β]
variable {tupleA : Fin n → α} {tupleB : Fin n → β}
variable {μA : α → F2} {μB : β → F2}

/-- The generated marked isomorphism is an actual bounded-lattice homomorphism,
not merely an equivalence of term-evaluation carriers. -/
noncomputable def PrebananaAbstractGeneratedMarkedIso.toGeneratedBoundedLatticeHom
    (e : PrebananaAbstractGeneratedMarkedIso α β tupleA tupleB μA μB) :
    BoundedLatticeHom
      (prebananaGeneratedBooleanSubalgebra α tupleA)
      (prebananaGeneratedBooleanSubalgebra β tupleB) where
  toFun := e.toGeneratedEquiv
  map_bot' := e.toGeneratedEquiv_map_bot
  map_top' := e.toGeneratedEquiv_map_top
  map_sup' := e.toGeneratedEquiv_map_sup
  map_inf' := e.toGeneratedEquiv_map_inf

/-- Injectivity makes this a Boolean-algebra embedding. -/
theorem PrebananaAbstractGeneratedMarkedIso.toGeneratedBoundedLatticeHom_injective
    (e : PrebananaAbstractGeneratedMarkedIso α β tupleA tupleB μA μB) :
    Function.Injective e.toGeneratedBoundedLatticeHom := by
  change Function.Injective e.toGeneratedEquiv
  exact e.toGeneratedEquiv.injective

/-- The generated homomorphism is also surjective onto the generated algebra. -/
theorem PrebananaAbstractGeneratedMarkedIso.toGeneratedBoundedLatticeHom_surjective
    (e : PrebananaAbstractGeneratedMarkedIso α β tupleA tupleB μA μB) :
    Function.Surjective e.toGeneratedBoundedLatticeHom := by
  change Function.Surjective e.toGeneratedEquiv
  exact e.toGeneratedEquiv.surjective

/-- The actual marked embedding preserves the distinguished unary predicate. -/
theorem PrebananaAbstractGeneratedMarkedIso.toGeneratedBoundedLatticeHom_preserves_mark
    (e : PrebananaAbstractGeneratedMarkedIso α β tupleA tupleB μA μB)
    (x : prebananaGeneratedBooleanSubalgebra α tupleA) :
    μB (e.toGeneratedBoundedLatticeHom x).val = μA x.val := by
  exact e.toGeneratedEquiv_preserves_mark x

/-- The embedding sends every distinguished generator to its counterpart. -/
theorem PrebananaAbstractGeneratedMarkedIso.toGeneratedBoundedLatticeHom_generator
    (e : PrebananaAbstractGeneratedMarkedIso α β tupleA tupleB μA μB)
    (i : Fin n) :
    (e.toGeneratedBoundedLatticeHom
      (⟨tupleA i,
        (prebananaGeneratedBooleanSubalgebra_mem_iff α tupleA _).mpr
          ⟨.generator i, rfl⟩⟩ :
        prebananaGeneratedBooleanSubalgebra α tupleA)).val =
      tupleB i := by
  exact e.toGeneratedEquiv_map_term (.generator i)

/-- In particular the bounded-lattice embedding preserves complements. -/
theorem PrebananaAbstractGeneratedMarkedIso.toGeneratedBoundedLatticeHom_map_compl
    (e : PrebananaAbstractGeneratedMarkedIso α β tupleA tupleB μA μB)
    (x : prebananaGeneratedBooleanSubalgebra α tupleA) :
    e.toGeneratedBoundedLatticeHom (xᶜ) =
      (e.toGeneratedBoundedLatticeHom x)ᶜ := by
  exact e.toGeneratedEquiv_map_compl x

end SuccessorTree.NonPrecompact
