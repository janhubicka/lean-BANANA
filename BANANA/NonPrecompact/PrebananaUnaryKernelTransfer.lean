import BANANA.NonPrecompact.PrebananaUnaryTermTruthTable

/-!
# Equality kernels of one-generator Boolean-term evaluations

The two truth values of a unary Boolean term determine the term
uniquely when it is evaluated at a proper nonzero Boolean element x.

Equivalently, the four unary truth functions are realised as the
four distinct Boolean elements 0, x, complement x and 1.

Consequently the Boolean-term equality relation generated by any
proper nonzero element x is independent of x. This gives the
well-definedness condition for a canonical Boolean isomorphism
between the subalgebras generated by two such elements in an
arbitrary (even infinite) Boolean algebra.

Mark preservation will be obtained separately from the
one-generator zero-marking lemma.
-/

namespace SuccessorTree.NonPrecompact

/-- The two truth values of a unary Boolean term. -/
def PrebananaBooleanTerm.oneGeneratorTruthProfile
    (t : PrebananaBooleanTerm 1) : Bool × Bool :=
  (t.evalPattern (fun _ : Fin 1 => false),
    t.evalPattern (fun _ : Fin 1 => true))

/-- At any proper nonzero Boolean element, the four possible
unary truth-function values are pairwise distinct. -/
theorem prebananaUnaryTruthValue_injective
    {α : Type*} [BooleanAlgebra α]
    (x : α) (hbot : x ≠ ⊥) (htop : x ≠ ⊤) :
    Function.Injective
      (fun p : Bool × Bool =>
        prebananaUnaryTruthValue x p.1 p.2) := by
  have hbotTop : (⊥ : α) ≠ ⊤ := by
    intro h
    apply hbot
    apply le_antisymm
    · simpa only [h] using (le_top : x ≤ (⊤ : α))
    · exact bot_le
  have hcompBot : xᶜ ≠ ⊥ := by
    intro h
    have hh := congrArg (fun z : α => zᶜ) h
    apply htop
    simpa only [compl_compl, compl_bot] using hh
  have hcompTop : xᶜ ≠ ⊤ := by
    intro h
    have hh := congrArg (fun z : α => zᶜ) h
    apply hbot
    simpa only [compl_compl, compl_top] using hh
  have hcompNe : xᶜ ≠ x := by
    intro h
    have hh : x ⊓ xᶜ = (⊥ : α) := inf_compl_eq_bot
    rw [h] at hh
    apply hbot
    simpa using hh
  rintro ⟨a, b⟩ ⟨c, d⟩ h
  cases a <;> cases b <;> cases c <;> cases d <;>
    first
    | rfl
    | (exfalso
       simp [prebananaUnaryTruthValue, hbot, htop, hbotTop,
         hcompBot, hcompTop, hcompNe] at h)

/-- For a proper nonzero generator x, equality of two term values
is equivalent to equality of their two-bit Boolean truth tables. -/
theorem prebananaOneGenerator_term_eq_iff_truthProfile
    {α : Type*} [BooleanAlgebra α]
    (x : α) (hbot : x ≠ ⊥) (htop : x ≠ ⊤)
    (t u : PrebananaBooleanTerm 1) :
    (t.evalBoolean (fun _ : Fin 1 => x) =
       u.evalBoolean (fun _ : Fin 1 => x)) ↔
      t.oneGeneratorTruthProfile = u.oneGeneratorTruthProfile := by
  have hInjective := prebananaUnaryTruthValue_injective x hbot htop
  constructor
  · intro heq
    apply hInjective
    change prebananaUnaryTruthValue x
        (t.evalPattern (fun _ : Fin 1 => false))
        (t.evalPattern (fun _ : Fin 1 => true)) =
      prebananaUnaryTruthValue x
        (u.evalPattern (fun _ : Fin 1 => false))
        (u.evalPattern (fun _ : Fin 1 => true))
    rw [← t.oneGenerator_truthTable x, ← u.oneGenerator_truthTable x]
    exact heq
  · intro heq
    rw [t.oneGenerator_truthTable x, u.oneGenerator_truthTable x]
    exact congrArg
      (fun p : Bool × Bool => prebananaUnaryTruthValue x p.1 p.2)
      heq

/-- Proper nonzero elements x and y have identical Boolean-term
equality kernels: the map sending the value of a term in x to
the value of the same term in y is automatically well defined. -/
theorem prebananaOneGenerator_termEqualities_transfer
    {α β : Type*} [BooleanAlgebra α] [BooleanAlgebra β]
    (x : α) (y : β)
    (hbotX : x ≠ ⊥) (htopX : x ≠ ⊤)
    (hbotY : y ≠ ⊥) (htopY : y ≠ ⊤)
    (t u : PrebananaBooleanTerm 1) :
    (t.evalBoolean (fun _ : Fin 1 => x) =
        u.evalBoolean (fun _ : Fin 1 => x)) ↔
      (t.evalBoolean (fun _ : Fin 1 => y) =
        u.evalBoolean (fun _ : Fin 1 => y)) := by
  exact (prebananaOneGenerator_term_eq_iff_truthProfile
    x hbotX htopX t u).trans
      (prebananaOneGenerator_term_eq_iff_truthProfile
        y hbotY htopY t u).symm

end SuccessorTree.NonPrecompact
