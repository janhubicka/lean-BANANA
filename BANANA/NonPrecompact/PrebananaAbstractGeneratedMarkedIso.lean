import BANANA.NonPrecompact.PrebananaAbstractGeneratedTermRange

/-!
# Marked generated Boolean isomorphism on abstract finite carriers

Finite tuples from arbitrary finite pre-BANANA Boolean algebras are
compared in the original Boolean-algebra carriers, not only after
enumerating their atoms.

An isomorphism is recorded as an equivalence of the values of
Boolean terms with two additional facts: each evaluated term goes
to the evaluation of the same term, and the F₂ marking is preserved.
Because *every* element of each term range has a term witness, the
term-evaluation condition simultaneously certifies preservation
of the Boolean operations and the distinguished generators.

The extension of this finite isomorphism to an automorphism of an
infinite Fraïssé limit remains a separate theorem.
-/

namespace SuccessorTree.NonPrecompact

/-- A marked Boolean isomorphism between the subalgebras generated by
two distinguished tuples, expressed on their term-evaluation ranges. -/
structure PrebananaAbstractGeneratedMarkedIso
    {n : ℕ}
    (α β : Type*)
    [BooleanAlgebra α] [BooleanAlgebra β]
    (tupleA : Fin n → α) (tupleB : Fin n → β)
    (μA : α → F2) (μB : β → F2) where
  equiv : prebananaAbstractTermRange α tupleA ≃
    prebananaAbstractTermRange β tupleB
  map_term : ∀ t : PrebananaBooleanTerm n,
    (equiv ⟨t.evalBoolean tupleA, ⟨t, rfl⟩⟩).val =
      t.evalBoolean tupleB
  map_mark : ∀ x : prebananaAbstractTermRange α tupleA,
    μB (equiv x).val = μA x.val

/-- Equal marked profiles induce a generator-preserving isomorphism
between the *actual* finite generated Boolean subalgebras. -/
noncomputable def prebananaAbstractGeneratedMarkedIso_of_profile_eq
    (α β : Type*)
    [BooleanAlgebra α] [Fintype α] [Nontrivial α]
    [BooleanAlgebra β] [Fintype β] [Nontrivial β]
    (μA : α → F2) (μB : β → F2)
    (hzeroA : μA ⊥ = 0) (htopA : μA ⊤ = 0)
    (haddA : ∀ x y : α, x ⊓ y = ⊥ →
      μA (x ⊔ y) = μA x + μA y)
    (hzeroB : μB ⊥ = 0) (htopB : μB ⊤ = 0)
    (haddB : ∀ x y : β, x ⊓ y = ⊥ →
      μB (x ⊔ y) = μB x + μB y)
    {n : ℕ} (tupleA : Fin n → α) (tupleB : Fin n → β)
    (hprofile :
      prebananaAbstractMarkedTupleProfile α μA hzeroA htopA haddA tupleA =
      prebananaAbstractMarkedTupleProfile β μB hzeroB htopB haddB tupleB) :
    PrebananaAbstractGeneratedMarkedIso α β tupleA tupleB μA μB where
  equiv := prebananaAbstractTermRangeEquiv_of_profile_eq
    α β μA μB hzeroA htopA haddA hzeroB htopB haddB
    tupleA tupleB hprofile
  map_term := prebananaAbstractTermRangeEquiv_eval_term
    α β μA μB hzeroA htopA haddA hzeroB htopB haddB
    tupleA tupleB hprofile
  map_mark := prebananaAbstractTermRangeEquiv_preserves_mark
    α β μA μB hzeroA htopA haddA hzeroB htopB haddB
    tupleA tupleB hprofile

/-- The inverse map also preserves the F₂ marking. -/
theorem PrebananaAbstractGeneratedMarkedIso.symm_preserves_mark
    {n : ℕ}
    {α β : Type*}
    [BooleanAlgebra α] [BooleanAlgebra β]
    {tupleA : Fin n → α} {tupleB : Fin n → β}
    {μA : α → F2} {μB : β → F2}
    (e : PrebananaAbstractGeneratedMarkedIso α β tupleA tupleB μA μB)
    (y : prebananaAbstractTermRange β tupleB) :
    μA (e.equiv.symm y).val = μB y.val := by
  simpa using (e.map_mark (e.equiv.symm y)).symm

/-- The isomorphism preserves every distinguished generator. -/
theorem PrebananaAbstractGeneratedMarkedIso.map_generator
    {n : ℕ}
    {α β : Type*}
    [BooleanAlgebra α] [BooleanAlgebra β]
    {tupleA : Fin n → α} {tupleB : Fin n → β}
    {μA : α → F2} {μB : β → F2}
    (e : PrebananaAbstractGeneratedMarkedIso α β tupleA tupleB μA μB)
    (i : Fin n) :
    (e.equiv ⟨tupleA i, ⟨.generator i, rfl⟩⟩).val = tupleB i :=
  e.map_term (.generator i)

end SuccessorTree.NonPrecompact
