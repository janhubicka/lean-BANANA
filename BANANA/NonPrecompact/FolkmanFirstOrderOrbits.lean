import BANANA.NonPrecompact.FolkmanFirstOrderClass
import BANANA.NonPrecompact.FirstOrderTupleOrbits

/-!
# Finite tuple orbits of the encoded Folkman limit

On each sort of a generated finite representative, the atom-membership
signatures of the generating tuple are distinct and nonzero. Thus the
numbers of atoms are bounded in each fixed tuple length. A finite pointed
atom code then determines the tuple up to an automorphism of the limit.
-/

namespace SuccessorTree.NonPrecompact

open FirstOrder CategoryTheory
open scoped FirstOrder symmDiff

private def atomEvaluation {d : ℕ} (a : Fin d) : FolkmanNativeCodeRing d →ₙ+* ZMod 2 where
  toFun x := if a ∈ ofBoolRing x then 1 else 0
  map_zero' := by
    change (if a ∈ ofBoolRing (0 : FolkmanNativeCodeRing d) then (1 : ZMod 2) else 0) = 0
    simp
  map_mul' x y := by
    change (if a ∈ ofBoolRing (x * y) then (1 : ZMod 2) else 0) =
      (if a ∈ ofBoolRing x then 1 else 0) * (if a ∈ ofBoolRing y then 1 else 0)
    by_cases hx : a ∈ ofBoolRing x <;> by_cases hy : a ∈ ofBoolRing y <;>
      simp [ofBoolRing_mul, Finset.inf_eq_inter, hx, hy]
  map_add' x y := by
    change (if a ∈ ofBoolRing (x + y) then (1 : ZMod 2) else 0) =
      (if a ∈ ofBoolRing x then 1 else 0) + (if a ∈ ofBoolRing y then 1 else 0)
    by_cases hx : a ∈ ofBoolRing x <;> by_cases hy : a ∈ ofBoolRing y <;>
      simp [ofBoolRing_add, Finset.mem_symmDiff, hx, hy, show (1 : ZMod 2) + 1 = 0 by decide]

private theorem atomEvaluation_apply {d : ℕ} (a : Fin d) (x : FolkmanNativeCodeRing d) :
    atomEvaluation a x = if a ∈ ofBoolRing x then 1 else 0 := rfl

private def agreeingCoordinates {L R : Type} [NonUnitalRing L] [NonUnitalRing R]
    (p : L → R → ZMod 2) (l l' : L →ₙ+* ZMod 2) (r r' : R →ₙ+* ZMod 2) :
    letI := folkmanProductStructure p
    Language.Substructure folkmanLanguage (L × R) := by
  letI := folkmanProductStructure p
  refine ⟨{z | l z.1 = l' z.1 ∧ r z.2 = r' z.2}, ?_⟩
  intro n op xs hx
  change ∀ i, l (xs i).1 = l' (xs i).1 ∧ r (xs i).2 = r' (xs i).2 at hx
  cases op with
  | zero =>
    change l 0 = l' 0 ∧ r 0 = r' 0
    simp
  | add =>
    change l ((xs 0).1 + (xs 1).1) = l' ((xs 0).1 + (xs 1).1) ∧
      r ((xs 0).2 + (xs 1).2) = r' ((xs 0).2 + (xs 1).2)
    simp only [map_add, (hx 0).1, (hx 1).1, (hx 0).2, (hx 1).2, eq_self, and_self]
  | mul =>
    change l ((xs 0).1 * (xs 1).1) = l' ((xs 0).1 * (xs 1).1) ∧
      r ((xs 0).2 * (xs 1).2) = r' ((xs 0).2 * (xs 1).2)
    simp only [map_mul, (hx 0).1, (hx 1).1, (hx 0).2, (hx 1).2, eq_self, and_self]
  | left =>
    change l (xs 0).1 = l' (xs 0).1 ∧ r 0 = r' 0
    exact ⟨(hx 0).1, by simp⟩
  | right =>
    change l 0 = l' 0 ∧ r (xs 0).2 = r' (xs 0).2
    exact ⟨by simp, (hx 0).2⟩

private theorem agrees_of_generated {L R : Type} [NonUnitalRing L] [NonUnitalRing R]
    (p : L → R → ZMod 2) (l l' : L →ₙ+* ZMod 2) (r r' : R →ₙ+* ZMod 2) {n : ℕ}
    (xs : Fin n → L × R)
    (hgen : letI := folkmanProductStructure p
      Language.Substructure.closure folkmanLanguage (Set.range xs) = ⊤)
    (hxs : ∀ i, l (xs i).1 = l' (xs i).1 ∧ r (xs i).2 = r' (xs i).2) :
    ∀ z : L × R, l z.1 = l' z.1 ∧ r z.2 = r' z.2 := by
  let _ := folkmanProductStructure p
  let S := agreeingCoordinates p l l' r r'
  have h := Language.Substructure.closure_le.mpr
    (show Set.range xs ⊆ (S : Set (L × R)) from by rintro _ ⟨i, rfl⟩; exact hxs i)
  rw [hgen] at h
  intro z
  exact h (Language.Substructure.mem_top z)

private theorem atoms_eq_of_singleton_evaluation_eq {d : ℕ} {a b : Fin d}
    (h : atomEvaluation a (toBoolRing {a}) = atomEvaluation b (toBoolRing {a})) :
    a = b := by
  by_contra hn
  simp [atomEvaluation_apply, Ne.symm hn] at h

private theorem card_le_of_signatures {d n : ℕ}
    (signature : Fin d → (Fin n → ZMod 2)) (hinj : Function.Injective signature)
    (hne : ∀ a, signature a ≠ 0) : d ≤ 2 ^ n - 1 := by
  classical
  let s := (Finset.univ : Finset (Fin n → ZMod 2)).erase 0
  have hin (a : Fin d) : signature a ∈ s :=
    Finset.mem_erase.mpr ⟨hne a, Finset.mem_univ _⟩
  have hc := Fintype.card_le_of_injective
    (fun a => (⟨_, hin a⟩ : s))
    (fun _ _ h => hinj (congrArg Subtype.val h))
  simpa [s, Fintype.card_fun, ZMod.card] using hc

/-- A representative generated by an `n`-tuple has at most `2^n - 1`
atoms in each sort, including when the tuple is empty. -/
theorem folkmanGeneratedRepresentative_atomCounts_le
    (A : FolkmanAtomStructure) {n : ℕ} (xs : Fin n → folkmanFirstOrderRepresentative A)
    (hgen : Language.Substructure.closure folkmanLanguage (Set.range xs) = ⊤) :
    A.leftCount ≤ 2 ^ n - 1 ∧ A.rightCount ≤ 2 ^ n - 1 := by
  let p := (folkmanNativeCodeRealisation A).pairing
  refine ⟨card_le_of_signatures (fun a i => atomEvaluation a (xs i).1) ?_ ?_,
    card_le_of_signatures (fun a i => atomEvaluation a (xs i).2) ?_ ?_⟩
  · intro a b hab
    exact atoms_eq_of_singleton_evaluation_eq ((agrees_of_generated p (atomEvaluation a)
      (atomEvaluation b) 0 0 xs hgen
      (fun i => ⟨congrFun hab i, rfl⟩) (toBoolRing {a}, 0)).1)
  · intro a ha
    have h := (agrees_of_generated p (atomEvaluation a) 0 0 0 xs hgen
      (fun i => ⟨congrFun ha i, rfl⟩) (toBoolRing {a}, 0)).1
    simp [atomEvaluation_apply] at h
  · intro a b hab
    exact atoms_eq_of_singleton_evaluation_eq ((agrees_of_generated p 0 0 (atomEvaluation a)
      (atomEvaluation b) xs hgen
      (fun i => ⟨rfl, congrFun hab i⟩) (0, toBoolRing {a})).2)
  · intro a ha
    have h := (agrees_of_generated p 0 0 (atomEvaluation a) 0 xs hgen
      (fun i => ⟨rfl, congrFun ha i⟩) (0, toBoolRing {a})).2
    simp [atomEvaluation_apply] at h

private theorem folkmanFirstOrderLimit_generated_tuple_factor
    (M : Bundled.{0} folkmanLanguage.Structure) [Countable M]
    (hM : Language.IsFraisseLimit folkmanFirstOrderClass M)
    {n : ℕ} (xs : Fin n → M) :
    ∃ (A : FolkmanAtomStructure)
      (f : folkmanFirstOrderRepresentative A ↪[folkmanLanguage] M)
      (ys : Fin n → folkmanFirstOrderRepresentative A),
      (∀ i, f (ys i) = xs i) ∧
        Language.Substructure.closure folkmanLanguage (Set.range ys) = ⊤ := by
  let S := Language.Substructure.closure folkmanLanguage (Set.range xs)
  let zs : Fin n → S := fun i => ⟨xs i, Language.Substructure.subset_closure ⟨i, rfl⟩⟩
  obtain ⟨A, ⟨e⟩⟩ := folkmanFirstOrderLimit_substructure_native M hM S
    (Language.Substructure.fg_closure (Set.finite_range xs))
  let f := S.subtype.comp e.symm.toEmbedding
  let ys : Fin n → folkmanFirstOrderRepresentative A := e ∘ zs
  have hcoords (i : Fin n) : f (ys i) = xs i := by
    simp [f, ys, zs, Function.comp_apply]
  refine ⟨A, f, ys, hcoords,
    Language.Substructure.map_injective_of_injective (f := f.toHom) f.injective ?_⟩
  rw [Language.Substructure.map_closure, ← Language.Hom.range_eq_map]
  have himage : f.toHom '' Set.range ys = Set.range xs := by
    rw [← Set.range_comp]
    exact congrArg Set.range (funext hcoords)
  rw [himage]
  change S = f.toHom.range
  ext x
  constructor
  · intro hx
    exact ⟨e ⟨x, hx⟩, by simp [f]⟩
  · rintro ⟨y, rfl⟩
    exact (e.symm y).property

private abbrev BoundedPointedAtomCode (n : ℕ) :=
  Σ l : Fin (2 ^ n), Σ r : Fin (2 ^ n),
    (Fin l.val → Fin r.val → ZMod 2) ×
      (Fin n → FolkmanNativeCodeRing l.val × FolkmanNativeCodeRing r.val)

private def BoundedPointedAtomCode.atomCode {n : ℕ} (b : BoundedPointedAtomCode n) :
    FolkmanAtomStructure := ⟨b.1.val, b.2.1.val, b.2.2.1⟩

/-- Automorphism orbits on encoded tuples use the full first-order language,
including the two coordinate projections and the pairing. -/
abbrev folkmanFirstOrderTupleOrbit (M : Bundled.{0} folkmanLanguage.Structure) (n : ℕ) :
    Setoid (Fin n → M) :=
  firstOrderTupleOrbit folkmanLanguage M n

/-- Every encoded countable Folkman Fraïssé limit is oligomorphic.
The orbit relation uses genuine automorphisms of the limit. -/
theorem folkmanFirstOrderLimit_tupleOrbits_finite
    (M : Bundled.{0} folkmanLanguage.Structure) [Countable M]
    (hM : Language.IsFraisseLimit folkmanFirstOrderClass M) (n : ℕ) :
    Finite (Quotient (folkmanFirstOrderTupleOrbit M n)) := by
  have hpointed (xs : Fin n → M) :
      ∃ (b : BoundedPointedAtomCode n)
        (f : folkmanFirstOrderRepresentative b.atomCode ↪[folkmanLanguage] M),
        ∀ i, f (b.2.2.2 i) = xs i := by
    obtain ⟨A, f, ys, hcoords, hgen⟩ := folkmanFirstOrderLimit_generated_tuple_factor M hM xs
    obtain ⟨hl, hr⟩ := folkmanGeneratedRepresentative_atomCounts_le A ys hgen
    have hpow : 0 < 2 ^ n := Nat.pow_pos (by decide)
    refine ⟨⟨⟨A.leftCount, by omega⟩, ⟨⟨A.rightCount, by omega⟩, A.edge, ys⟩⟩, ?_⟩
    cases A
    exact ⟨f, hcoords⟩
  exact finite_firstOrderTupleOrbits_of_pointedCover hM.ultrahomogeneous
    (fun b : BoundedPointedAtomCode n => folkmanFirstOrderRepresentative b.atomCode)
    (fun b => b.2.2.2) (fun _ => Language.Structure.FG.of_finite) hpointed

end SuccessorTree.NonPrecompact
