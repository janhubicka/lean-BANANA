import BANANA.NonPrecompact.FolkmanDirectedFiniteLocalFiniteness
import BANANA.NonPrecompact.FolkmanGeneratedTwoSortProfileIso

/-!
# From equal finite Folkman profiles to ambient generated-ring equivalences

Each finite stage witness supplies a non-unital ring equivalence between
the subring generated by its coded tuple and the actual subring generated
by the original ambient tuple.

If two finite stage profiles agree, the existing finite-profile theorem
provides an equivalence between the two coded generated rings.
Conjugating by both stage equivalences then gives ring equivalences
between the *actual ambient* generated subrings on both sorts.

This file intentionally proves only preservation of the ring
operations. Preservation of distinguished generators and the
cross-sort pairing on the ambient carriers requires additional
coercion/naturality lemmas and remains a separate verification gate.
No global ambient automorphism is asserted here.
-/

namespace SuccessorTree.NonPrecompact

/-- The isomorphism of the actual left generated non-unital
subrings induced by equality of two finite stage tuple profiles.

Neither ambient sort is required to be unital. -/
noncomputable def folkmanAmbientLeftGeneratedEquiv_of_profile_eq
    {LA RA LB RB : Type*}
    [NonUnitalRing LA] [NonUnitalRing RA]
    [NonUnitalRing LB] [NonUnitalRing RB]
    {βA : LA → RA → F2} {βB : LB → RB → F2}
    {nL nR : ℕ}
    {xsA : Fin nL → LA} {ysA : Fin nR → RA}
    {xsB : Fin nL → LB} {ysB : Fin nR → RB}
    (w : FolkmanFiniteTupleStageWitness (β := βA) xsA ysA)
    (v : FolkmanFiniteTupleStageWitness (β := βB) xsB ysB)
    (h : w.profile = v.profile) :
    NonUnitalSubring.closure (Set.range xsA) ≃+*
      NonUnitalSubring.closure (Set.range xsB) := by
  classical
  let e : FolkmanGeneratedTwoSortIso
      w.leftTuple w.rightTuple v.leftTuple v.rightTuple :=
    folkmanGeneratedTwoSortIso_of_profile_eq
      w.leftTuple w.rightTuple v.leftTuple v.rightTuple h
  exact w.left_generatedEquiv.symm.trans
    (e.left.trans v.left_generatedEquiv)

/-- The corresponding isomorphism of the actual right generated
non-unital subrings, using the same complete two-sort profile. -/
noncomputable def folkmanAmbientRightGeneratedEquiv_of_profile_eq
    {LA RA LB RB : Type*}
    [NonUnitalRing LA] [NonUnitalRing RA]
    [NonUnitalRing LB] [NonUnitalRing RB]
    {βA : LA → RA → F2} {βB : LB → RB → F2}
    {nL nR : ℕ}
    {xsA : Fin nL → LA} {ysA : Fin nR → RA}
    {xsB : Fin nL → LB} {ysB : Fin nR → RB}
    (w : FolkmanFiniteTupleStageWitness (β := βA) xsA ysA)
    (v : FolkmanFiniteTupleStageWitness (β := βB) xsB ysB)
    (h : w.profile = v.profile) :
    NonUnitalSubring.closure (Set.range ysA) ≃+*
      NonUnitalSubring.closure (Set.range ysB) := by
  classical
  let e : FolkmanGeneratedTwoSortIso
      w.leftTuple w.rightTuple v.leftTuple v.rightTuple :=
    folkmanGeneratedTwoSortIso_of_profile_eq
      w.leftTuple w.rightTuple v.leftTuple v.rightTuple h
  exact w.right_generatedEquiv.symm.trans
    (e.right.trans v.right_generatedEquiv)

end SuccessorTree.NonPrecompact
