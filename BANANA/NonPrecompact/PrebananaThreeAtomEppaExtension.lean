import BANANA.NonPrecompact.PrebananaThreeAtomPartialIsomorphism

/-!
# Non-extension of the three-atom pre-BANANA partial isomorphism

The source is the powerset Boolean algebra on three unmarked atoms.
`prebanana_threeAtom_partialIsomorphism` gives an actual marked
isomorphism from the four-element subalgebra generated by `{0}`
to that generated by `{0,1}`. Both elements are in the source.

Any embedding of the entire source into a finite Boolean algebra
is strictly order-preserving. The finite-order obstruction therefore
prevents *every* automorphism of *every* finite extension from
carrying the embedded `{0}` to the embedded `{0,1}`.

This establishes the finite-algebra non-extension step used to
disprove EPPA. The general class-level EPPA predicate is not
introduced here, and the circulation manuscript remains unchanged.
-/

namespace SuccessorTree.NonPrecompact

/-- An injective bounded-lattice homomorphism from the three-atom
powerset to any finite Boolean algebra cannot admit an automorphism
extending the indicated map between the two generated subalgebras. -/
theorem prebananaThreeAtom_no_boundedLattice_extension
    {β : Type*} [BooleanAlgebra β] [Fintype β]
    (f : BoundedLatticeHom (Finset (Fin 3)) β)
    (hinj : Function.Injective f) :
    ¬ ∃ e : β ≃o β,
      e (f ({0} : Finset (Fin 3))) =
        f ({0, 1} : Finset (Fin 3)) := by
  have hmono : Monotone f := by
    intro s t hst
    have hmeet : f s ⊓ f t = f s := by
      calc
        f s ⊓ f t = f (s ⊓ t) := (map_inf f s t).symm
        _ = f s := congrArg f (inf_eq_left.mpr hst)
    exact inf_eq_left.mp hmeet
  exact prebananaThreeAtoms_no_finite_extension
    f (hmono.strictMono_of_injective hinj)

/-- The source admits a genuine marking-preserving partial isomorphism
which sends a Boolean element to a proper enlargement, while no
automorphism of any finite Boolean extension can realise that move.
The first conjunct is witnessed by the explicit generated-subalgebra
isomorphism, not by an arbitrary map between two elements. -/
theorem prebanana_threeAtom_Eppa_witness :
    (∃ p : PrebananaGeneratedMarkedIso
        (prebananaUnmarked 2) (prebananaUnmarked 2)
        (fun _ : Fin 1 => ({0} : Finset (Fin 3)))
        (fun _ : Fin 1 => ({0, 1} : Finset (Fin 3))),
      (p.equiv (prebananaTermRange_generator
        (prebananaUnmarked 2)
        (fun _ : Fin 1 => ({0} : Finset (Fin 3))) 0)).val =
          ({0, 1} : Finset (Fin 3))) ∧
    (∀ (β : Type*) [BooleanAlgebra β] [Fintype β]
      (f : BoundedLatticeHom (Finset (Fin 3)) β),
      Function.Injective f →
      ¬ ∃ e : β ≃o β,
        e (f ({0} : Finset (Fin 3))) =
          f ({0, 1} : Finset (Fin 3))) := by
  refine ⟨⟨prebanana_threeAtom_partialIsomorphism,
    prebanana_threeAtom_partialIsomorphism_generator⟩, ?_⟩
  intro β _ _ f hinj
  exact prebananaThreeAtom_no_boundedLattice_extension f hinj

end SuccessorTree.NonPrecompact
