import BANANA.NonPrecompact.PrebananaFiveAryCylinderFiniteFamily
import BANANA.NonPrecompact.PrebananaFiveAryCylinderMarkedModel
import BANANA.NonPrecompact.PrebananaGeneratedBooleanClosure

/-!
# Local finiteness of the explicit countable pre-BANANA cylinder algebra

Every finite tuple of the countable cylinder algebra has a common
finite-stage presentation. The full image of this finite marked
Boolean stage is a finite Boolean subalgebra of the cylinder algebra,
containing the tuple. Consequently, the Boolean subalgebra generated
by that tuple is finite.

The proof uses the actual stage maps and standard Mathlib
`BooleanSubalgebra.map` and `BooleanSubalgebra.closure` rather than
reimplementing the Boolean term calculus. It is independent of
Fraïssé homogeneity.
-/

namespace SuccessorTree.NonPrecompact

open scoped Classical

/-- The subalgebra generated by any finite tuple of cylinders
is contained in the image of some finite five-ary Boolean stage. -/
theorem prebananaFiveAryCylinder_generated_le_finiteStage
    {k : ℕ} (xs : Fin k → PrebananaFiveAryCylinderLimitCarrier) :
    ∃ N : ℕ,
      prebananaGeneratedBooleanSubalgebra
        PrebananaFiveAryCylinderLimitCarrier xs ≤
      (⊤ : BooleanSubalgebra
        (prebananaFiveAryBooleanStage N).carrier).map
          (prebananaFiveAryCylinderStageHom N) := by
  classical
  obtain ⟨N, ss, hss⟩ :=
    prebananaFiveAryCylinder_finiteFamily_commonStage xs
  let L : BooleanSubalgebra PrebananaFiveAryCylinderLimitCarrier :=
    (⊤ : BooleanSubalgebra
      (prebananaFiveAryBooleanStage N).carrier).map
        (prebananaFiveAryCylinderStageHom N)
  have hin : Set.range xs ⊆ (L : Set PrebananaFiveAryCylinderLimitCarrier) := by
    intro x hx
    obtain ⟨i, rfl⟩ := hx
    change ∃ y : (prebananaFiveAryBooleanStage N).carrier,
      y ∈ (⊤ : BooleanSubalgebra (prebananaFiveAryBooleanStage N).carrier) ∧
        (prebananaFiveAryCylinderStageHom N) y = xs i
    refine ⟨ss i, BooleanSubalgebra.mem_top, ?_⟩
    exact hss i
  refine ⟨N, ?_⟩
  change BooleanSubalgebra.closure (Set.range xs) ≤ L
  exact BooleanSubalgebra.closure_le.mpr hin

/-- A finite family of elements of the countable cylinder algebra
generates a *finite* Boolean subalgebra. This local-finiteness
result is the finite-domain foundation for back-and-forth. -/
noncomputable instance prebananaFiveAryCylinder_generatedFinite
    {k : ℕ} (xs : Fin k → PrebananaFiveAryCylinderLimitCarrier) :
    Finite (prebananaGeneratedBooleanSubalgebra
      PrebananaFiveAryCylinderLimitCarrier xs) := by
  classical
  obtain ⟨N, hN⟩ :=
    prebananaFiveAryCylinder_generated_le_finiteStage xs
  let f : BoundedLatticeHom
      (prebananaFiveAryBooleanStage N).carrier
      PrebananaFiveAryCylinderLimitCarrier :=
    prebananaFiveAryCylinderStageHom N
  let L : BooleanSubalgebra PrebananaFiveAryCylinderLimitCarrier :=
    (⊤ : BooleanSubalgebra (prebananaFiveAryBooleanStage N).carrier).map f
  have hrange : (L : Set PrebananaFiveAryCylinderLimitCarrier) ⊆
      Set.range f := by
    intro x hx
    change x ∈
      (⊤ : BooleanSubalgebra (prebananaFiveAryBooleanStage N).carrier).map f
      at hx
    obtain ⟨y, _, hy⟩ := BooleanSubalgebra.mem_map.mp hx
    exact ⟨y, hy⟩
  have hLfinite : (L : Set PrebananaFiveAryCylinderLimitCarrier).Finite :=
    (Set.finite_range f).subset hrange
  have hgenerated :
      (prebananaGeneratedBooleanSubalgebra
        PrebananaFiveAryCylinderLimitCarrier xs :
        Set PrebananaFiveAryCylinderLimitCarrier).Finite :=
    hLfinite.subset (fun x hx => hN hx)
  exact hgenerated.to_subtype

end SuccessorTree.NonPrecompact
