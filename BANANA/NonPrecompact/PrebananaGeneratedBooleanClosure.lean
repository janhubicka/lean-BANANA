import BANANA.NonPrecompact.PrebananaAbstractGeneratedMarkedIso
import Mathlib.Order.BooleanSubalgebra

/-!
# Finitely generated Boolean subalgebras are exactly term-evaluation ranges

The previous abstract term-range modules use the subset of an arbitrary
Boolean algebra consisting of all evaluations of finite Boolean terms
in a distinguished tuple. Here we identify this subset with the
standard Mathlib Boolean subalgebra generated by that tuple.

This statement holds in *any* Boolean algebra, finite or infinite.
It is the missing interface for applying finite marked generated
isomorphisms to the finite substructures of a homogeneous limit.
It does not itself construct such a limit or assert an automorphism
extension theorem.
-/

namespace SuccessorTree.NonPrecompact

/-- The Boolean subalgebra generated by finitely many named elements. -/
def prebananaGeneratedBooleanSubalgebra
    {n : ℕ} (α : Type*) [BooleanAlgebra α]
    (tuple : Fin n → α) : BooleanSubalgebra α :=
  BooleanSubalgebra.closure (Set.range tuple)

/-- A Boolean element belongs to the generated subalgebra if and only
if it is the value of a finite Boolean term in the generators. -/
theorem prebananaGeneratedBooleanSubalgebra_mem_iff
    {n : ℕ} (α : Type*) [BooleanAlgebra α]
    (tuple : Fin n → α) (x : α) :
    x ∈ prebananaGeneratedBooleanSubalgebra α tuple ↔
      ∃ t : PrebananaBooleanTerm n, t.evalBoolean tuple = x := by
  classical
  let L : BooleanSubalgebra α := {
    carrier := {y : α | ∃ t : PrebananaBooleanTerm n, t.evalBoolean tuple = y}
    supClosed' := by
      intro a ha b hb
      obtain ⟨t, ht⟩ := ha
      obtain ⟨u, hu⟩ := hb
      refine ⟨.join t u, ?_⟩
      change t.evalBoolean tuple ⊔ u.evalBoolean tuple = a ⊔ b
      rw [ht, hu]
    infClosed' := by
      intro a ha b hb
      obtain ⟨t, ht⟩ := ha
      obtain ⟨u, hu⟩ := hb
      refine ⟨.meet t u, ?_⟩
      change t.evalBoolean tuple ⊓ u.evalBoolean tuple = a ⊓ b
      rw [ht, hu]
    compl_mem' := by
      intro a ha
      obtain ⟨t, ht⟩ := ha
      refine ⟨.complement t, ?_⟩
      change (t.evalBoolean tuple)ᶜ = aᶜ
      rw [ht]
    bot_mem' := ⟨.zero, rfl⟩
  }
  have hmin : BooleanSubalgebra.closure (Set.range tuple) ≤ L := by
    apply BooleanSubalgebra.closure_le.mpr
    intro a ha
    obtain ⟨i, rfl⟩ := ha
    exact ⟨.generator i, rfl⟩
  constructor
  · intro hx
    have hxL : x ∈ L := hmin hx
    exact hxL
  · rintro ⟨t, rfl⟩
    induction t with
    | zero =>
        exact BooleanSubalgebra.bot_mem
    | one =>
        exact BooleanSubalgebra.top_mem
    | generator i =>
        exact BooleanSubalgebra.subset_closure (Set.mem_range_self i)
    | complement t ih =>
        simpa [PrebananaBooleanTerm.evalBoolean] using
          (BooleanSubalgebra.compl_mem ih)
    | join t u iht ihu =>
        simpa [PrebananaBooleanTerm.evalBoolean] using
          (BooleanSubalgebra.sup_mem iht ihu)
    | meet t u iht ihu =>
        simpa [PrebananaBooleanTerm.evalBoolean] using
          (BooleanSubalgebra.inf_mem iht ihu)

/-- The term-evaluation range and the actual Boolean subalgebra
generated by the tuple have the same underlying elements. -/
noncomputable def prebananaAbstractTermRangeEquivGenerated
    {n : ℕ} (α : Type*) [BooleanAlgebra α]
    (tuple : Fin n → α) :
    prebananaAbstractTermRange α tuple ≃
      prebananaGeneratedBooleanSubalgebra α tuple where
  toFun x :=
    ⟨x.val, (prebananaGeneratedBooleanSubalgebra_mem_iff α tuple x.val).mpr x.property⟩
  invFun y :=
    ⟨y.val, (prebananaGeneratedBooleanSubalgebra_mem_iff α tuple y.val).mp y.property⟩
  left_inv := by
    intro x
    apply Subtype.ext
    rfl
  right_inv := by
    intro y
    apply Subtype.ext
    rfl

/-- A marked isomorphism of term-value ranges induces an equivalence
of the corresponding actual finitely generated Boolean subalgebras.
This is an equivalence of carriers; explicit operation-preservation
lemmas can be composed with this interface separately. -/
noncomputable def PrebananaAbstractGeneratedMarkedIso.toGeneratedEquiv
    {n : ℕ} {α β : Type*}
    [BooleanAlgebra α] [BooleanAlgebra β]
    {tupleA : Fin n → α} {tupleB : Fin n → β}
    {μA : α → F2} {μB : β → F2}
    (e : PrebananaAbstractGeneratedMarkedIso α β tupleA tupleB μA μB) :
    prebananaGeneratedBooleanSubalgebra α tupleA ≃
      prebananaGeneratedBooleanSubalgebra β tupleB :=
  (prebananaAbstractTermRangeEquivGenerated α tupleA).symm.trans
    (e.equiv.trans (prebananaAbstractTermRangeEquivGenerated β tupleB))

/-- This induced equivalence preserves the F₂ marking. -/
theorem PrebananaAbstractGeneratedMarkedIso.toGeneratedEquiv_preserves_mark
    {n : ℕ} {α β : Type*}
    [BooleanAlgebra α] [BooleanAlgebra β]
    {tupleA : Fin n → α} {tupleB : Fin n → β}
    {μA : α → F2} {μB : β → F2}
    (e : PrebananaAbstractGeneratedMarkedIso α β tupleA tupleB μA μB)
    (x : prebananaGeneratedBooleanSubalgebra α tupleA) :
    μB (e.toGeneratedEquiv x).val = μA x.val := by
  exact e.map_mark ((prebananaAbstractTermRangeEquivGenerated α tupleA).symm x)

end SuccessorTree.NonPrecompact
