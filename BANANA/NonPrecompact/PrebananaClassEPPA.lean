import BANANA.NonPrecompact.PrebananaThreeAtomEppaExtension
import BANANA.NonPrecompact.PrebananaPowersetBridge

/-!
# Failure of EPPA for the finite pre-BANANA class in atom coordinates

The finite pre-BANANA class is represented by nonempty finite marked
atom sets of even total parity. Embeddings of the associated Boolean
powersets are inverse images of surjective marked atom partitions.

Every subalgebra generated by a finite tuple is represented by its
Boolean-term evaluation range. The existing `PrebananaGeneratedMarkedIso`
records exactly the operations, marking and distinguished generators
of a partial automorphism between such generated subalgebras.

The EPPA predicate below asks for one finite marked extension of every
finite source in which all such partial automorphisms extend to marked
Boolean automorphisms. We formalise the latter as order isomorphisms
preserving the marking. An order isomorphism between Boolean algebras
automatically preserves their Boolean operations.

The explicit marked four-element partial automorphism of the unmarked
three-atom source cannot be extended in *any* finite Boolean target
by the finite-order obstruction. Consequently the entire class fails
this EPPA property.

The presentation by standard finite atom sets is separate from the
abstract finite-Boolean-algebra representation, whose equivalence
with marked atom partitions is established in the existing modules.
No circulation TeX prose is modified.
-/

namespace SuccessorTree.NonPrecompact

/-- Every marked atom-partition embedding induces a strictly
order-preserving map between its finite Boolean powersets. -/
theorem prebananaBooleanMap_strictMono
    {A B : PrebananaAtomStructure}
    (f : PrebananaAtomEmbedding A B) :
    StrictMono (prebananaBooleanMap f) := by
  have hmono : Monotone (prebananaBooleanMap f) := by
    intro s t hst
    have hmeet :
        prebananaBooleanMap f s ⊓ prebananaBooleanMap f t =
          prebananaBooleanMap f s := by
      calc
        prebananaBooleanMap f s ⊓ prebananaBooleanMap f t =
            prebananaBooleanMap f (s ⊓ t) :=
          (prebananaBooleanMap_inter f s t).symm
        _ = prebananaBooleanMap f s :=
          congrArg (prebananaBooleanMap f) (inf_eq_left.mpr hst)
    exact inf_eq_left.mp hmeet
  exact hmono.strictMono_of_injective (prebananaBooleanMap_injective f)

/-- Class-level EPPA for the standard finite marked-atom presentation.

For each finite source A, one finite marked target B and one marked
embedding f must extend *every* marked partial automorphism between
subalgebras generated by finite tuples. An automorphism of B is
represented by a marking-preserving order isomorphism of its Boolean
powerset. This is the usual finite functional-language EPPA property
expressed through explicit tuple-generated Boolean subalgebras. -/
def prebananaAtomClassEPPA : Prop :=
  ∀ A : PrebananaAtomStructure,
    ∃ B : PrebananaAtomStructure,
      ∃ f : PrebananaAtomEmbedding A B,
        ∀ (n : ℕ)
          (xs ys : Fin n → Finset (Fin A.atomCount)),
          PrebananaGeneratedMarkedIso A A xs ys →
          ∃ e : Finset (Fin B.atomCount) ≃o Finset (Fin B.atomCount),
            (∀ s, prebananaBooleanParity B (e s) =
              prebananaBooleanParity B s) ∧
            ∀ i : Fin n,
              e (prebananaBooleanMap f (xs i)) =
                prebananaBooleanMap f (ys i)

/-- The pre-BANANA class fails EPPA: the partial isomorphism sending
one source atom to its proper enlargement cannot extend to an
automorphism of any finite marked extension. -/
theorem prebananaAtomClassEPPA_fails :
    ¬ prebananaAtomClassEPPA := by
  intro hEPPA
  obtain ⟨B, f, hB⟩ := hEPPA (prebananaUnmarked 2)
  let xs : Fin 1 → Finset (Fin 3) := fun _ => {0}
  let ys : Fin 1 → Finset (Fin 3) := fun _ => {0, 1}
  obtain ⟨e, _, he⟩ :=
    hB 1 xs ys prebanana_threeAtom_partialIsomorphism
  have hext :
      e (prebananaBooleanMap f ({0} : Finset (Fin 3))) =
        prebananaBooleanMap f ({0, 1} : Finset (Fin 3)) := by
    simpa only [xs, ys] using he (0 : Fin 1)
  exact
    (prebananaThreeAtoms_no_finite_extension
      (prebananaBooleanMap f) (prebananaBooleanMap_strictMono f))
      ⟨e, hext⟩

end SuccessorTree.NonPrecompact
