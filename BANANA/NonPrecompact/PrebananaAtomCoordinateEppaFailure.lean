import BANANA.NonPrecompact.PrebananaThreeAtomEppaExtension
import BANANA.NonPrecompact.PrebananaGeneratedMarkedIsomorphism
import BANANA.NonPrecompact.PrebananaPowersetBridge

/-!
# Failure of EPPA for finite marked atom-coordinate Boolean structures

A partial isomorphism between finite Boolean subalgebras is represented
by a marked isomorphism of the subalgebras generated by equally indexed
tuples. All finite Boolean subalgebras have such presentations.

The class-level extension property below asks that every such partial
isomorphism extend to a mark-preserving Boolean automorphism of a finite
extension, where embeddings are represented by partitions of atoms.
This is the faithful finite atom-coordinate form of EPPA for pre-BANANA.

The three-atom witness from the preceding module disproves this
extension property. No assumptions about the countable Fraïssé limit
are needed.
-/

namespace SuccessorTree.NonPrecompact

/-- Every atom-partition embedding induces a genuine bounded-lattice
homomorphism between the corresponding finite Boolean powersets. -/
noncomputable def PrebananaAtomEmbedding.toPowersetHom
    {A B : PrebananaAtomStructure}
    (f : PrebananaAtomEmbedding A B) :
    BoundedLatticeHom
      (Finset (Fin A.atomCount))
      (Finset (Fin B.atomCount)) where
  toFun := prebananaBooleanMap f
  map_bot' := prebananaBooleanMap_empty f
  map_top' := prebananaBooleanMap_univ f
  map_sup' := prebananaBooleanMap_union f
  map_inf' := prebananaBooleanMap_inter f

/-- Its underlying Boolean map is injective because the atom
partition is surjective. -/
theorem PrebananaAtomEmbedding.toPowersetHom_injective
    {A B : PrebananaAtomStructure}
    (f : PrebananaAtomEmbedding A B) :
    Function.Injective f.toPowersetHom :=
  prebananaBooleanMap_injective f

/-- The finite-atom-coordinate EPPA extension property: every
mark-preserving partial isomorphism of finitely generated Boolean
subalgebras extends to a mark-preserving automorphism after a
finite marked atom-partition embedding. -/
def prebananaAtomCoordinateEPPA : Prop :=
  ∀ (A : PrebananaAtomStructure) (n : ℕ)
    (tupleFrom tupleTo : Fin n → Finset (Fin A.atomCount)),
    PrebananaGeneratedMarkedIso A A tupleFrom tupleTo →
    ∃ B : PrebananaAtomStructure,
      ∃ f : PrebananaAtomEmbedding A B,
        ∃ aut : Finset (Fin B.atomCount) ≃o Finset (Fin B.atomCount),
          (∀ s : Finset (Fin B.atomCount),
            prebananaBooleanParity B (aut s) = prebananaBooleanParity B s) ∧
          (∀ i : Fin n,
            aut (prebananaBooleanMap f (tupleFrom i)) =
              prebananaBooleanMap f (tupleTo i))

/-- The explicit unmarked three-atom partial isomorphism refutes
the extension property for the entire finite atom-coordinate class. -/
theorem prebananaAtomCoordinateEPPA_false :
    ¬ prebananaAtomCoordinateEPPA := by
  intro h
  obtain ⟨B, f, aut, _hparity, hmove⟩ :=
    h (prebananaUnmarked 2) 1
      (fun _ : Fin 1 => ({0} : Finset (Fin 3)))
      (fun _ : Fin 1 => ({0, 1} : Finset (Fin 3)))
      prebanana_threeAtom_partialIsomorphism
  have himpossible :=
    prebananaThreeAtom_no_boundedLattice_extension
      f.toPowersetHom f.toPowersetHom_injective
  apply himpossible
  refine ⟨aut, ?_⟩
  change aut (prebananaBooleanMap f ({0} : Finset (Fin 3))) =
    prebananaBooleanMap f ({0, 1} : Finset (Fin 3))
  exact hmove 0

end SuccessorTree.NonPrecompact
