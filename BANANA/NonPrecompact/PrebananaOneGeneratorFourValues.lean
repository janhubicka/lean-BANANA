import BANANA.NonPrecompact.PrebananaGeneratedBooleanClosure
import BANANA.NonPrecompact.PrebananaAmenabilityMeasureObstruction

/-!
# One-generator subalgebras in arbitrary pre-BANANA Boolean algebras

An element `x` of any Boolean algebra, including an infinite one,
generates no more than four Boolean elements: bottom, top, x, and
the complement of x. We prove this at the level of the actual
`BooleanSubalgebra.closure`, not merely at the level of terms.

Consequently every such one-generator subalgebra is finite, even
when its ambient Boolean algebra is not. If the marking is finitely
additive with value zero on bottom and top, an unmarked generator
has an unmarked complement. Hence its entire generated subalgebra
is unmarked.

These statements supply finite local data for the application of
ultrahomogeneity in the circulated pre-BANANA non-amenability proof.
They do not construct the infinite Fraïssé limit or its automorphisms.
-/

namespace SuccessorTree.NonPrecompact

/-- The set of at most four Boolean values associated with x is
itself a Boolean subalgebra. -/
private def prebananaFourValueSubalgebra
    {α : Type*} [BooleanAlgebra α] (x : α) :
    BooleanSubalgebra α where
  carrier := {⊥, ⊤, x, xᶜ}
  bot_mem' := by simp
  compl_mem' := by
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz ⊢
    rcases hz with rfl | rfl | rfl | rfl <;>
      simp [compl_compl]
  supClosed' := by
    intro z hz w hw
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz hw ⊢
    rcases hz with rfl | rfl | rfl | rfl <;>
      rcases hw with rfl | rfl | rfl | rfl <;>
      simp [sup_compl_eq_top, sup_comm, sup_assoc]
  infClosed' := by
    intro z hz w hw
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz hw ⊢
    rcases hz with rfl | rfl | rfl | rfl <;>
      rcases hw with rfl | rfl | rfl | rfl <;>
      simp [inf_compl_eq_bot, inf_comm, inf_assoc]

/-- The generated Boolean subalgebra of one element is contained
in the four-element candidate subalgebra. -/
theorem prebananaOneGenerator_le_fourValues
    {α : Type*} [BooleanAlgebra α] (x : α) :
    prebananaGeneratedBooleanSubalgebra α (fun _ : Fin 1 => x) ≤
      prebananaFourValueSubalgebra x := by
  change BooleanSubalgebra.closure (Set.range (fun _ : Fin 1 => x)) ≤
    prebananaFourValueSubalgebra x
  apply BooleanSubalgebra.closure_le.mpr
  intro z hz
  obtain ⟨i, rfl⟩ := hz
  show x ∈ prebananaFourValueSubalgebra x
  change x ∈ ({⊥, ⊤, x, xᶜ} : Set α)
  simp

/-- A Boolean element generated by x is bottom, top, x, or xᶜ. -/
theorem prebananaOneGenerator_fourValues
    {α : Type*} [BooleanAlgebra α] (x : α)
    (z : prebananaGeneratedBooleanSubalgebra α (fun _ : Fin 1 => x)) :
    z.val = ⊥ ∨ z.val = ⊤ ∨ z.val = x ∨ z.val = xᶜ := by
  have h := (prebananaOneGenerator_le_fourValues x) z.property
  change z.val ∈ ({⊥, ⊤, x, xᶜ} : Set α) at h
  simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using h

/-- Every one-generated Boolean subalgebra is finite, whether or
not its ambient Boolean algebra is finite. -/
noncomputable instance prebananaOneGeneratorFinite
    {α : Type*} [BooleanAlgebra α] (x : α) :
    Finite (prebananaGeneratedBooleanSubalgebra α (fun _ : Fin 1 => x)) := by
  classical
  have hfour : ({⊥, ⊤, x, xᶜ} : Set α).Finite := by simp
  have hsub :
      (prebananaGeneratedBooleanSubalgebra α (fun _ : Fin 1 => x) : Set α) ⊆
        {⊥, ⊤, x, xᶜ} := by
    intro z hz
    have hmem : z ∈ prebananaFourValueSubalgebra x :=
      prebananaOneGenerator_le_fourValues x hz
    change z ∈ ({⊥, ⊤, x, xᶜ} : Set α) at hmem
    exact hmem
  exact (hfour.subset hsub).to_subtype

/-- In an even-total finitely additive F₂-marked Boolean algebra,
a zero-marked element has a zero-marked complement. -/
theorem prebananaZeroMark_complement
    {α : Type*} [BooleanAlgebra α] (μ : α → F2)
    (htop : μ ⊤ = 0)
    (hadd : ∀ y z : α, y ⊓ z = ⊥ →
      μ (y ⊔ z) = μ y + μ z)
    (x : α) (hx : μ x = 0) :
    μ xᶜ = 0 := by
  have h := hadd x xᶜ inf_compl_eq_bot
  rw [sup_compl_eq_top, htop, hx] at h
  simpa using h.symm

/-- Every element of the Boolean subalgebra generated by a
zero-marked element is itself zero-marked. -/
theorem prebananaOneGenerator_all_zero_mark
    {α : Type*} [BooleanAlgebra α] (μ : α → F2)
    (hbot : μ ⊥ = 0) (htop : μ ⊤ = 0)
    (hadd : ∀ y z : α, y ⊓ z = ⊥ →
      μ (y ⊔ z) = μ y + μ z)
    (x : α) (hx : μ x = 0)
    (z : prebananaGeneratedBooleanSubalgebra α (fun _ : Fin 1 => x)) :
    μ z.val = 0 := by
  rcases prebananaOneGenerator_fourValues x z with h0 | h1 | h2 | h3
  · simpa [h0] using hbot
  · simpa [h1] using htop
  · simpa [h2] using hx
  · simpa [h3] using prebananaZeroMark_complement μ htop hadd x hx

end SuccessorTree.NonPrecompact
