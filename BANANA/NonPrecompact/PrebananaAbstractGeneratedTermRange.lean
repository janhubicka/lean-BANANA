import BANANA.NonPrecompact.PrebananaAbstractMarkedTupleProfile

/-!
# Generated term ranges in arbitrary finite marked Boolean algebras

Equal complete finite marked tuple profiles imply identical Boolean
term-equation kernels and term markings. The two term-evaluation
ranges in their original abstract Boolean carriers are therefore
in bijection, by evaluating the same term in each tuple.

This bridge is independent of an atom enumeration of the input
Boolean algebras. The final packaging of Boolean operations and
extension to automorphisms of an infinite Fraïssé limit are
separate goals.
-/

namespace SuccessorTree.NonPrecompact

/-- The actual carrier of the Boolean subalgebra generated by a tuple,
given as the subtype of values of its Boolean terms. -/
def prebananaAbstractTermRange
    {n : ℕ} (α : Type*) [BooleanAlgebra α]
    (tuple : Fin n → α) : Type _ :=
  {x : α // ∃ t : PrebananaBooleanTerm n, t.evalBoolean tuple = x}

/-- Equal marked profiles give a bijection on the generated elements
of the two original finite Boolean algebras. -/
noncomputable def prebananaAbstractTermRangeEquiv_of_profile_eq
    (α β : Type*)
    [BooleanAlgebra α] [Fintype α] [Nontrivial α]
    [BooleanAlgebra β] [Fintype β] [Nontrivial β]
    (μA : α → F2) (μB : β → F2)
    (hzeroA : μA ⊥ = 0) (htopA : μA ⊤ = 0)
    (haddA : ∀ x y : α, x ⊓ y = ⊥ →
      μA (x ⊔ y) = μA x + μA y)
    (hzeroB : μB ⊥ = 0) (htopB : μB ⊤ = 0)
    (haddB : ∀ x y : β, x ⊓ y = ⊥ →
      μB (x ⊔ y) = μB x + μB y)
    {n : ℕ} (tupleA : Fin n → α) (tupleB : Fin n → β)
    (hprofile :
      prebananaAbstractMarkedTupleProfile α μA hzeroA htopA haddA tupleA =
      prebananaAbstractMarkedTupleProfile β μB hzeroB htopB haddB tupleB) :
    prebananaAbstractTermRange α tupleA ≃
      prebananaAbstractTermRange β tupleB := by
  classical
  let hEq : ∀ t u : PrebananaBooleanTerm n,
      (t.evalBoolean tupleA = u.evalBoolean tupleA) ↔
        (t.evalBoolean tupleB = u.evalBoolean tupleB) :=
    prebananaAbstractTerm_eq_iff_of_profile_eq α β μA μB
      hzeroA htopA haddA hzeroB htopB haddB
      tupleA tupleB hprofile
  let toB (x : prebananaAbstractTermRange α tupleA) :
      prebananaAbstractTermRange β tupleB :=
    ⟨(Classical.choose x.property).evalBoolean tupleB,
      ⟨Classical.choose x.property, rfl⟩⟩
  let toA (y : prebananaAbstractTermRange β tupleB) :
      prebananaAbstractTermRange α tupleA :=
    ⟨(Classical.choose y.property).evalBoolean tupleA,
      ⟨Classical.choose y.property, rfl⟩⟩
  refine {
    toFun := toB
    invFun := toA
    left_inv := ?_
    right_inv := ?_
  }
  · intro x
    apply Subtype.ext
    change (Classical.choose (toB x).property).evalBoolean tupleA = x.val
    have hB :
        (Classical.choose (toB x).property).evalBoolean tupleB =
          (Classical.choose x.property).evalBoolean tupleB :=
      Classical.choose_spec (toB x).property
    exact ((hEq _ _).mpr hB).trans (Classical.choose_spec x.property)
  · intro y
    apply Subtype.ext
    change (Classical.choose (toA y).property).evalBoolean tupleB = y.val
    have hA :
        (Classical.choose (toA y).property).evalBoolean tupleA =
          (Classical.choose y.property).evalBoolean tupleA :=
      Classical.choose_spec (toA y).property
    exact ((hEq _ _).mp hA).trans (Classical.choose_spec y.property)

/-- The profile-induced bijection maps every term value to the
value of the same term in the target tuple. -/
theorem prebananaAbstractTermRangeEquiv_eval_term
    (α β : Type*)
    [BooleanAlgebra α] [Fintype α] [Nontrivial α]
    [BooleanAlgebra β] [Fintype β] [Nontrivial β]
    (μA : α → F2) (μB : β → F2)
    (hzeroA : μA ⊥ = 0) (htopA : μA ⊤ = 0)
    (haddA : ∀ x y : α, x ⊓ y = ⊥ →
      μA (x ⊔ y) = μA x + μA y)
    (hzeroB : μB ⊥ = 0) (htopB : μB ⊤ = 0)
    (haddB : ∀ x y : β, x ⊓ y = ⊥ →
      μB (x ⊔ y) = μB x + μB y)
    {n : ℕ} (tupleA : Fin n → α) (tupleB : Fin n → β)
    (hprofile :
      prebananaAbstractMarkedTupleProfile α μA hzeroA htopA haddA tupleA =
      prebananaAbstractMarkedTupleProfile β μB hzeroB htopB haddB tupleB)
    (t : PrebananaBooleanTerm n) :
    (prebananaAbstractTermRangeEquiv_of_profile_eq
      α β μA μB hzeroA htopA haddA hzeroB htopB haddB
      tupleA tupleB hprofile
      ⟨t.evalBoolean tupleA, ⟨t, rfl⟩⟩).val =
        t.evalBoolean tupleB := by
  classical
  let x : prebananaAbstractTermRange α tupleA :=
    ⟨t.evalBoolean tupleA, ⟨t, rfl⟩⟩
  have hx :
      (Classical.choose x.property).evalBoolean tupleA =
        t.evalBoolean tupleA :=
    Classical.choose_spec x.property
  change (Classical.choose x.property).evalBoolean tupleB =
    t.evalBoolean tupleB
  exact (prebananaAbstractTerm_eq_iff_of_profile_eq
    α β μA μB hzeroA htopA haddA hzeroB htopB haddB
    tupleA tupleB hprofile _ t).mp hx

/-- The profile-induced bijection preserves the F₂ marking on every
generated element of the original abstract finite Boolean carriers. -/
theorem prebananaAbstractTermRangeEquiv_preserves_mark
    (α β : Type*)
    [BooleanAlgebra α] [Fintype α] [Nontrivial α]
    [BooleanAlgebra β] [Fintype β] [Nontrivial β]
    (μA : α → F2) (μB : β → F2)
    (hzeroA : μA ⊥ = 0) (htopA : μA ⊤ = 0)
    (haddA : ∀ x y : α, x ⊓ y = ⊥ →
      μA (x ⊔ y) = μA x + μA y)
    (hzeroB : μB ⊥ = 0) (htopB : μB ⊤ = 0)
    (haddB : ∀ x y : β, x ⊓ y = ⊥ →
      μB (x ⊔ y) = μB x + μB y)
    {n : ℕ} (tupleA : Fin n → α) (tupleB : Fin n → β)
    (hprofile :
      prebananaAbstractMarkedTupleProfile α μA hzeroA htopA haddA tupleA =
      prebananaAbstractMarkedTupleProfile β μB hzeroB htopB haddB tupleB)
    (x : prebananaAbstractTermRange α tupleA) :
    μB ((prebananaAbstractTermRangeEquiv_of_profile_eq
      α β μA μB hzeroA htopA haddA hzeroB htopB haddB
      tupleA tupleB hprofile x).val) = μA x.val := by
  classical
  let t := Classical.choose x.property
  have ht : t.evalBoolean tupleA = x.val :=
    Classical.choose_spec x.property
  change μB (t.evalBoolean tupleB) = μA x.val
  exact (prebananaAbstractTerm_mark_of_profile_eq
    α β μA μB hzeroA htopA haddA hzeroB htopB haddB
    tupleA tupleB hprofile t).symm.trans (congrArg μA ht)

end SuccessorTree.NonPrecompact
