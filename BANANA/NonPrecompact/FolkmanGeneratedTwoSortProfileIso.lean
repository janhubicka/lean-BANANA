import BANANA.NonPrecompact.FolkmanGeneratedNonunitalPairing

/-!
# A single two-sort generated-structure isomorphism from tuple profiles

This packages the separate left/right native non-unital ring
equivalences, named-generator preservation and cross-sort pairing
preservation in one statement. It is a finite, original-operation
interface intended for a subsequent homogeneous-limit argument.

Equal profiles are sufficient for the isomorphism; this file does
not assert that an isomorphism extends to an automorphism of a limit.
-/

namespace SuccessorTree.NonPrecompact

open scoped Classical BigOperators

/-- A distinguished generator as an element of the native non-unital
subring generated by its tuple. -/
def folkmanGeneratedTupleCoordinate
    {n atoms : ℕ}
    (xs : Fin n → Finset (Fin atoms)) (i : Fin n) :
    folkmanGeneratedNonunitalSubring (fun j => toBoolRing (xs j)) :=
  ⟨toBoolRing (xs i),
    (FolkmanRingTerm.generator i).eval_mem_generated
      (fun j => toBoolRing (xs j))⟩

/-- A pairing-preserving isomorphism of two finite generated
Folkman two-sort structures, sending each named generator to its
corresponding named generator. Ring operations are preserved by
the two RingEquiv fields, which are valid for non-unital rings. -/
structure FolkmanGeneratedTwoSortIso
    {A B : FolkmanAtomStructure} {nL nR : ℕ}
    (xsA : Fin nL → Finset (Fin A.leftCount))
    (ysA : Fin nR → Finset (Fin A.rightCount))
    (xsB : Fin nL → Finset (Fin B.leftCount))
    (ysB : Fin nR → Finset (Fin B.rightCount)) where
  left :
    folkmanGeneratedNonunitalSubring (fun i => toBoolRing (xsA i)) ≃+*
      folkmanGeneratedNonunitalSubring (fun i => toBoolRing (xsB i))
  right :
    folkmanGeneratedNonunitalSubring (fun i => toBoolRing (ysA i)) ≃+*
      folkmanGeneratedNonunitalSubring (fun i => toBoolRing (ysB i))
  map_left_generators : ∀ i,
    left (folkmanGeneratedTupleCoordinate xsA i) =
      folkmanGeneratedTupleCoordinate xsB i
  map_right_generators : ∀ i,
    right (folkmanGeneratedTupleCoordinate ysA i) =
      folkmanGeneratedTupleCoordinate ysB i
  map_pairing : ∀
      (x : folkmanGeneratedNonunitalSubring (fun i => toBoolRing (xsA i)))
      (y : folkmanGeneratedNonunitalSubring (fun i => toBoolRing (ysA i))),
      (∑ a ∈ ofBoolRing (left x).val,
        ∑ b ∈ ofBoolRing (right y).val, B.edge a b) =
      ∑ a ∈ ofBoolRing x.val, ∑ b ∈ ofBoolRing y.val, A.edge a b

/-- Equal finite two-sort tuple profiles yield an isomorphism of
the generated non-unital structures in their actual ring language.
This theorem makes no global automorphism-orbit claim. -/
noncomputable def folkmanGeneratedTwoSortIso_of_profile_eq
    {A B : FolkmanAtomStructure} {nL nR : ℕ}
    (xsA : Fin nL → Finset (Fin A.leftCount))
    (ysA : Fin nR → Finset (Fin A.rightCount))
    (xsB : Fin nL → Finset (Fin B.leftCount))
    (ysB : Fin nR → Finset (Fin B.rightCount))
    (h : folkmanAtomTupleProfile A xsA ysA =
      folkmanAtomTupleProfile B xsB ysB) :
    FolkmanGeneratedTwoSortIso xsA ysA xsB ysB := by
  classical
  let hL : folkmanTupleNonzeroPatterns xsA =
      folkmanTupleNonzeroPatterns xsB :=
    congrArg (fun z : FolkmanAtomTupleProfile nL nR => z.1.1) h
  let hR : folkmanTupleNonzeroPatterns ysA =
      folkmanTupleNonzeroPatterns ysB :=
    congrArg (fun z : FolkmanAtomTupleProfile nL nR => z.1.2) h
  refine {
    left := folkmanGeneratedNonunitalRingEquiv_of_patterns_eq xsA xsB hL
    right := folkmanGeneratedNonunitalRingEquiv_of_patterns_eq ysA ysB hR
    map_left_generators := ?_
    map_right_generators := ?_
    map_pairing := ?_
  }
  · intro i
    apply Subtype.ext
    simpa only [folkmanGeneratedTupleCoordinate] using
      (folkmanGeneratedNonunitalRingEquiv_generator
        (fun j => toBoolRing (xsA j))
        (fun j => toBoolRing (xsB j))
        (folkmanRingTerm_nativeEqualities_of_patterns_eq xsA xsB hL) i)
  · intro i
    apply Subtype.ext
    simpa only [folkmanGeneratedTupleCoordinate] using
      (folkmanGeneratedNonunitalRingEquiv_generator
        (fun j => toBoolRing (ysA j))
        (fun j => toBoolRing (ysB j))
        (folkmanRingTerm_nativeEqualities_of_patterns_eq ysA ysB hR) i)
  · intro x y
    exact folkmanGeneratedNonunitalRingEquivs_preserve_pairing
      xsA ysA xsB ysB h x y

end SuccessorTree.NonPrecompact
