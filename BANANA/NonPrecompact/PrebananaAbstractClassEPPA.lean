import BANANA.NonPrecompact.PrebananaClassEPPA
import BANANA.NonPrecompact.PrebananaOneGeneratorMarkedIso
import BANANA.NonPrecompact.PrebananaThreeAtomEppaExtension

/-!
# EPPA failure for the actual class of finite marked Boolean algebras

The finite atom-coordinate class-level EPPA failure is proved in
`PrebananaClassEPPA`. Here we state the corresponding property
directly for arbitrary finite Boolean algebras carrying a
disjoint-additive F₂-valued marking with zero values at bottom and top.

We encode the finite carrier, its Boolean-algebra structure and the
marking in one structure. An embedding preserves the bounded-lattice
operations, is injective, and preserves marking. A partial automorphism
is an operation- and mark-preserving isomorphism between subalgebras
generated by finite tuples. Every finite Boolean subalgebra admits
such a tuple presentation.

The concrete three-atom all-unmarked Boolean algebra is an instance
of this class. The marked isomorphism between the four-element
subalgebras generated by {0} and {0,1}, combined with the finite
order-automorphism obstruction, disproves EPPA directly in these
abstract carriers. No circulation manuscript text is changed.
-/

namespace SuccessorTree.NonPrecompact

/-- A nontrivial finite Boolean algebra equipped with an admissible
disjoint-additive parity marking. -/
structure PrebananaFiniteBooleanModel where
  carrier : Type
  [booleanAlgebra : BooleanAlgebra carrier]
  [finite : Fintype carrier]
  [nontrivial : Nontrivial carrier]
  μ : carrier → F2
  μ_bot : μ ⊥ = 0
  μ_top : μ ⊤ = 0
  μ_add : ∀ x y : carrier, x ⊓ y = ⊥ →
    μ (x ⊔ y) = μ x + μ y

attribute [instance] PrebananaFiniteBooleanModel.booleanAlgebra
  PrebananaFiniteBooleanModel.finite
  PrebananaFiniteBooleanModel.nontrivial

/-- A marking-preserving embedding of arbitrary finite
pre-BANANA Boolean algebras. -/
structure PrebananaFiniteBooleanEmbedding
    (A B : PrebananaFiniteBooleanModel) where
  hom : BoundedLatticeHom A.carrier B.carrier
  injective : Function.Injective hom
  preserves_μ : ∀ x : A.carrier, B.μ (hom x) = A.μ x

/-- The ordinary finite-functional-language EPPA property, expressed
through the canonical generated-subalgebra descriptions of partial
automorphisms. One finite marked extension must extend every
partial automorphism of each finite marked source. -/
def prebananaFiniteBooleanClassEPPA : Prop :=
  ∀ A : PrebananaFiniteBooleanModel,
    ∃ B : PrebananaFiniteBooleanModel,
      ∃ f : PrebananaFiniteBooleanEmbedding A B,
        ∀ (n : ℕ) (xs ys : Fin n → A.carrier),
          PrebananaAbstractGeneratedMarkedIso
            A.carrier A.carrier xs ys A.μ A.μ →
          ∃ e : B.carrier ≃o B.carrier,
            (∀ x : B.carrier, B.μ (e x) = B.μ x) ∧
            (∀ i : Fin n,
              e (f.hom (xs i)) = f.hom (ys i))

/-- The all-unmarked three-atom Boolean algebra, now in the
abstract finite-Boolean-carrier presentation. -/
def prebananaThreeAtomAbstractModel : PrebananaFiniteBooleanModel where
  carrier := Finset (Fin 3)
  booleanAlgebra := inferInstance
  finite := inferInstance
  nontrivial := inferInstance
  μ := fun _ => 0
  μ_bot := rfl
  μ_top := rfl
  μ_add := by
    intro x y hxy
    simp

/-- The actual class of all finite marked Boolean algebras
does not have EPPA. In particular no finite marked Boolean
extension can extend the three-atom witness. -/
theorem prebananaFiniteBooleanClassEPPA_fails :
    ¬ prebananaFiniteBooleanClassEPPA := by
  intro hEPPA
  let A := prebananaThreeAtomAbstractModel
  obtain ⟨B, f, hExt⟩ := hEPPA A
  let sx : Finset (Fin 3) := {0}
  let sy : Finset (Fin 3) := {0, 1}
  have hx : prebananaProperZeroMark A.μ sx := by
    refine ⟨?_, ?_, rfl⟩
    · decide
    · decide
  have hy : prebananaProperZeroMark A.μ sy := by
    refine ⟨?_, ?_, rfl⟩
    · decide
    · decide
  let p : PrebananaAbstractGeneratedMarkedIso
      A.carrier A.carrier
      (fun _ : Fin 1 => sx) (fun _ : Fin 1 => sy) A.μ A.μ :=
    prebananaOneGeneratorMarkedIso
      A.μ A.μ A.μ_bot A.μ_top A.μ_add
      A.μ_bot A.μ_top A.μ_add sx sy hx hy
  obtain ⟨e, _, he⟩ := hExt 1
    (fun _ : Fin 1 => sx) (fun _ : Fin 1 => sy) p
  have hext : e (f.hom sx) = f.hom sy := he 0
  exact
    (prebananaThreeAtom_no_boundedLattice_extension
      f.hom f.injective) ⟨e, hext⟩

end SuccessorTree.NonPrecompact
