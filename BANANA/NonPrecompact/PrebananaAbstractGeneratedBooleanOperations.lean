import BANANA.NonPrecompact.PrebananaAbstractGeneratedMarkedIso

/-!
# Boolean operations on abstract finite generated term ranges

The generated marked isomorphism maps the value of every finite
Boolean term to the value of the identical term in the target tuple.
We explicitly construct the finite generated Boolean operations on
their actual carriers and verify their preservation, without using
atom enumeration or changing any circulation prose.

This is finite algebra: extension to automorphisms of the countable
Fraïssé limit remains separate.
-/

namespace SuccessorTree.NonPrecompact

/-- Zero belongs to the Boolean algebra generated by a tuple. -/
def prebananaAbstractTermRange_zero
    {n : ℕ} (α : Type*) [BooleanAlgebra α]
    (tuple : Fin n → α) : prebananaAbstractTermRange α tuple :=
  ⟨⊥, ⟨.zero, rfl⟩⟩

/-- The unit belongs to the generated Boolean algebra. -/
def prebananaAbstractTermRange_one
    {n : ℕ} (α : Type*) [BooleanAlgebra α]
    (tuple : Fin n → α) : prebananaAbstractTermRange α tuple :=
  ⟨⊤, ⟨.one, rfl⟩⟩

/-- Every distinguished generator belongs to the generated algebra. -/
def prebananaAbstractTermRange_generator
    {n : ℕ} (α : Type*) [BooleanAlgebra α]
    (tuple : Fin n → α) (i : Fin n) :
    prebananaAbstractTermRange α tuple :=
  ⟨tuple i, ⟨.generator i, rfl⟩⟩

/-- Closure under Boolean complementation. -/
noncomputable def prebananaAbstractTermRange_complement
    {n : ℕ} (α : Type*) [BooleanAlgebra α]
    (tuple : Fin n → α) (x : prebananaAbstractTermRange α tuple) :
    prebananaAbstractTermRange α tuple := by
  classical
  let t := Classical.choose x.property
  refine ⟨x.valᶜ, ⟨.complement t, ?_⟩⟩
  change (t.evalBoolean tuple)ᶜ = x.valᶜ
  rw [Classical.choose_spec x.property]

/-- Closure under Boolean joins. -/
noncomputable def prebananaAbstractTermRange_join
    {n : ℕ} (α : Type*) [BooleanAlgebra α]
    (tuple : Fin n → α) (x y : prebananaAbstractTermRange α tuple) :
    prebananaAbstractTermRange α tuple := by
  classical
  let t := Classical.choose x.property
  let u := Classical.choose y.property
  refine ⟨x.val ⊔ y.val, ⟨.join t u, ?_⟩⟩
  change t.evalBoolean tuple ⊔ u.evalBoolean tuple = x.val ⊔ y.val
  rw [Classical.choose_spec x.property, Classical.choose_spec y.property]

/-- Closure under Boolean meets. -/
noncomputable def prebananaAbstractTermRange_meet
    {n : ℕ} (α : Type*) [BooleanAlgebra α]
    (tuple : Fin n → α) (x y : prebananaAbstractTermRange α tuple) :
    prebananaAbstractTermRange α tuple := by
  classical
  let t := Classical.choose x.property
  let u := Classical.choose y.property
  refine ⟨x.val ⊓ y.val, ⟨.meet t u, ?_⟩⟩
  change t.evalBoolean tuple ⊓ u.evalBoolean tuple = x.val ⊓ y.val
  rw [Classical.choose_spec x.property, Classical.choose_spec y.property]

@[simp] theorem prebananaAbstractTermRange_complement_val
    {n : ℕ} (α : Type*) [BooleanAlgebra α]
    (tuple : Fin n → α) (x : prebananaAbstractTermRange α tuple) :
    (prebananaAbstractTermRange_complement α tuple x).val = x.valᶜ := rfl

@[simp] theorem prebananaAbstractTermRange_join_val
    {n : ℕ} (α : Type*) [BooleanAlgebra α]
    (tuple : Fin n → α) (x y : prebananaAbstractTermRange α tuple) :
    (prebananaAbstractTermRange_join α tuple x y).val = x.val ⊔ y.val := rfl

@[simp] theorem prebananaAbstractTermRange_meet_val
    {n : ℕ} (α : Type*) [BooleanAlgebra α]
    (tuple : Fin n → α) (x y : prebananaAbstractTermRange α tuple) :
    (prebananaAbstractTermRange_meet α tuple x y).val = x.val ⊓ y.val := rfl

/-- The image of a term-value element is determined by any term
representing it, not only by the stored existential witness. -/
theorem PrebananaAbstractGeneratedMarkedIso.map_term_of_value
    {n : ℕ} {α β : Type*}
    [BooleanAlgebra α] [BooleanAlgebra β]
    {tupleA : Fin n → α} {tupleB : Fin n → β}
    {μA : α → F2} {μB : β → F2}
    (e : PrebananaAbstractGeneratedMarkedIso α β tupleA tupleB μA μB)
    (x : prebananaAbstractTermRange α tupleA)
    (t : PrebananaBooleanTerm n)
    (ht : t.evalBoolean tupleA = x.val) :
    (e.equiv x).val = t.evalBoolean tupleB := by
  have hx : x = (⟨t.evalBoolean tupleA, ⟨t, rfl⟩⟩ :
      prebananaAbstractTermRange α tupleA) := Subtype.ext ht.symm
  rw [hx]
  exact e.map_term t

/-- The abstract generated marked isomorphism preserves zero. -/
theorem PrebananaAbstractGeneratedMarkedIso.map_zero
    {n : ℕ} {α β : Type*}
    [BooleanAlgebra α] [BooleanAlgebra β]
    {tupleA : Fin n → α} {tupleB : Fin n → β}
    {μA : α → F2} {μB : β → F2}
    (e : PrebananaAbstractGeneratedMarkedIso α β tupleA tupleB μA μB) :
    (e.equiv (prebananaAbstractTermRange_zero α tupleA)).val = (⊥ : β) := by
  exact e.map_term_of_value _ .zero rfl

/-- The abstract generated marked isomorphism preserves unit. -/
theorem PrebananaAbstractGeneratedMarkedIso.map_one
    {n : ℕ} {α β : Type*}
    [BooleanAlgebra α] [BooleanAlgebra β]
    {tupleA : Fin n → α} {tupleB : Fin n → β}
    {μA : α → F2} {μB : β → F2}
    (e : PrebananaAbstractGeneratedMarkedIso α β tupleA tupleB μA μB) :
    (e.equiv (prebananaAbstractTermRange_one α tupleA)).val = (⊤ : β) := by
  exact e.map_term_of_value _ .one rfl

/-- The isomorphism preserves Boolean complement. -/
theorem PrebananaAbstractGeneratedMarkedIso.map_complement
    {n : ℕ} {α β : Type*}
    [BooleanAlgebra α] [BooleanAlgebra β]
    {tupleA : Fin n → α} {tupleB : Fin n → β}
    {μA : α → F2} {μB : β → F2}
    (e : PrebananaAbstractGeneratedMarkedIso α β tupleA tupleB μA μB)
    (x : prebananaAbstractTermRange α tupleA) :
    (e.equiv (prebananaAbstractTermRange_complement α tupleA x)).val =
      (e.equiv x).valᶜ := by
  classical
  let t := Classical.choose x.property
  have ht : t.evalBoolean tupleA = x.val := Classical.choose_spec x.property
  have hc : (PrebananaBooleanTerm.complement t).evalBoolean tupleA =
      (prebananaAbstractTermRange_complement α tupleA x).val := by
    rw [prebananaAbstractTermRange_complement_val]
    change (t.evalBoolean tupleA)ᶜ = x.valᶜ
    rw [ht]
  calc
    (e.equiv (prebananaAbstractTermRange_complement α tupleA x)).val =
        (PrebananaBooleanTerm.complement t).evalBoolean tupleB :=
      e.map_term_of_value _ _ hc
    _ = (t.evalBoolean tupleB)ᶜ := rfl
    _ = (e.equiv x).valᶜ := by
      rw [e.map_term_of_value x t ht]

/-- The isomorphism preserves Boolean joins. -/
theorem PrebananaAbstractGeneratedMarkedIso.map_join
    {n : ℕ} {α β : Type*}
    [BooleanAlgebra α] [BooleanAlgebra β]
    {tupleA : Fin n → α} {tupleB : Fin n → β}
    {μA : α → F2} {μB : β → F2}
    (e : PrebananaAbstractGeneratedMarkedIso α β tupleA tupleB μA μB)
    (x y : prebananaAbstractTermRange α tupleA) :
    (e.equiv (prebananaAbstractTermRange_join α tupleA x y)).val =
      (e.equiv x).val ⊔ (e.equiv y).val := by
  classical
  let t := Classical.choose x.property
  let u := Classical.choose y.property
  have ht : t.evalBoolean tupleA = x.val := Classical.choose_spec x.property
  have hu : u.evalBoolean tupleA = y.val := Classical.choose_spec y.property
  have hj : (PrebananaBooleanTerm.join t u).evalBoolean tupleA =
      (prebananaAbstractTermRange_join α tupleA x y).val := by
    rw [prebananaAbstractTermRange_join_val]
    change t.evalBoolean tupleA ⊔ u.evalBoolean tupleA = x.val ⊔ y.val
    rw [ht, hu]
  calc
    (e.equiv (prebananaAbstractTermRange_join α tupleA x y)).val =
        (PrebananaBooleanTerm.join t u).evalBoolean tupleB :=
      e.map_term_of_value _ _ hj
    _ = t.evalBoolean tupleB ⊔ u.evalBoolean tupleB := rfl
    _ = (e.equiv x).val ⊔ (e.equiv y).val := by
      rw [e.map_term_of_value x t ht, e.map_term_of_value y u hu]

/-- The isomorphism preserves Boolean meets. -/
theorem PrebananaAbstractGeneratedMarkedIso.map_meet
    {n : ℕ} {α β : Type*}
    [BooleanAlgebra α] [BooleanAlgebra β]
    {tupleA : Fin n → α} {tupleB : Fin n → β}
    {μA : α → F2} {μB : β → F2}
    (e : PrebananaAbstractGeneratedMarkedIso α β tupleA tupleB μA μB)
    (x y : prebananaAbstractTermRange α tupleA) :
    (e.equiv (prebananaAbstractTermRange_meet α tupleA x y)).val =
      (e.equiv x).val ⊓ (e.equiv y).val := by
  classical
  let t := Classical.choose x.property
  let u := Classical.choose y.property
  have ht : t.evalBoolean tupleA = x.val := Classical.choose_spec x.property
  have hu : u.evalBoolean tupleA = y.val := Classical.choose_spec y.property
  have hm : (PrebananaBooleanTerm.meet t u).evalBoolean tupleA =
      (prebananaAbstractTermRange_meet α tupleA x y).val := by
    rw [prebananaAbstractTermRange_meet_val]
    change t.evalBoolean tupleA ⊓ u.evalBoolean tupleA = x.val ⊓ y.val
    rw [ht, hu]
  calc
    (e.equiv (prebananaAbstractTermRange_meet α tupleA x y)).val =
        (PrebananaBooleanTerm.meet t u).evalBoolean tupleB :=
      e.map_term_of_value _ _ hm
    _ = t.evalBoolean tupleB ⊓ u.evalBoolean tupleB := rfl
    _ = (e.equiv x).val ⊓ (e.equiv y).val := by
      rw [e.map_term_of_value x t ht, e.map_term_of_value y u hu]

end SuccessorTree.NonPrecompact
