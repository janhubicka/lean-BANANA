import BANANA.NonPrecompact.FirstOrderHereditaryExpansionRestriction

/-!
# Expanded functions taking values in the reduct closure

Added functions may take values in the substructure generated by their
arguments in the reduct. In a locally finite reduct this is exactly the
condition that all finite reduct substructures remain substructures.
The term yielding the value need only exist separately for each tuple.
-/

namespace SuccessorTree.NonPrecompact

open CategoryTheory FirstOrder Function
open scoped FirstOrder
open Language.Structure

universe u v u' v' w

variable {L : Language.{u, v}} {L' : Language.{u', v'}}
  {N : Type w} [L.Structure N] [T : L'.Structure N]

/-- The value of each expanded function lies in the substructure generated
by its arguments in the reduct. This includes nullary functions. -/
def ExpandedFunctionsInReductClosure : Prop :=
  ∀ (n : ℕ) (f : L'.Functions n) (x : Fin n → N),
    funMap f x ∈ Language.Substructure.closure L (Set.range x)

/-- Each value is in the reduct closure exactly when it is the value of
some reduct term in the input variables. The term can depend on the input. -/
theorem expandedFunctionsInReductClosure_iff_term_values :
    ExpandedFunctionsInReductClosure (L := L) (L' := L') (N := N) ↔
      ∀ (n : ℕ) (f : L'.Functions n) (x : Fin n → N),
        ∃ t : L.Term (Fin n), t.realize x = funMap f x := by
  constructor
  · intro h n f x
    obtain ⟨t, ht⟩ := Language.Substructure.mem_closure_iff_exists_term.1 (h n f x)
    have hrange : ∀ y : Set.range x, ∃ i, x i = (y : N) := fun y => y.property
    choose index hindex using hrange
    refine ⟨t.relabel index, ?_⟩
    rw [Language.Term.realize_relabel, show x ∘ index = ((↑) : Set.range x → N) from
      funext hindex]
    exact ht
  · intro h n f x
    obtain ⟨t, ht⟩ := h n f x
    rw [← ht]
    exact t.realize_mem x fun i => Language.Substructure.subset_closure ⟨i, rfl⟩

/-- The reduct closure condition ensures compatibility with every
reduct embedding, from finite or infinite source structures. -/
theorem expandedRangeClosed_of_functionsInReductClosure
    {M : Type w} [L.Structure M]
    (h : ExpandedFunctionsInReductClosure (L := L) (L' := L') (N := N))
    (e : M ↪[L] N) : ExpandedRangeClosed (L' := L') e := by
  intro n f x
  have hsub : Language.Substructure.closure L (Set.range (e ∘ x)) ≤ e.toHom.range :=
    Language.Substructure.closure_le.2 fun _ ⟨i, hi⟩ => ⟨x i, hi⟩
  exact hsub (h n f (e ∘ x))

/-- For locally finite reducts, compatibility with every finite reduct
embedding forces each expanded operation to take values in the reduct
substructure generated by the arguments. -/
theorem expandedFunctionsInReductClosure_iff_finite_reduct_embeddings
    (hLoc : ∀ s : Finset N, Finite (Language.Substructure.closure L (s : Set N))) :
    ExpandedFunctionsInReductClosure (L := L) (L' := L') (N := N) ↔
      ∀ (M : Type w) [L.Structure M] [Finite M] (e : M ↪[L] N),
        ExpandedRangeClosed (L' := L') e := by
  constructor
  · intro h M _ _ e
    exact expandedRangeClosed_of_functionsInReductClosure h e
  · intro h n f x
    classical
    let S := Language.Substructure.closure L (Set.range x)
    let y : Fin n → S := fun i =>
      ⟨x i, Language.Substructure.subset_closure ⟨i, rfl⟩⟩
    let e := Language.Substructure.subtype S
    have hr := Set.finite_range x
    have hfin := hLoc hr.toFinset
    rw [Set.Finite.coe_toFinset] at hfin
    have : Finite S := hfin
    obtain ⟨z, hz⟩ := h S e n f y
    change (z : N) = funMap f x at hz
    exact hz ▸ z.property

/-- Reduct term values give restrictions in the same hereditary expanded
class, with the same underlying embedding and the prescribed reduct. -/
theorem exists_hereditary_restriction_of_functionsInReductClosure
    {M : Type w} [L.Structure M] [Finite M]
    {K : Set (Bundled.{w} L'.Structure)} (hK : Language.Hereditary K)
    (hN : Bundled.mk N T ∈ K) (φ : L →ᴸ L') [φ.IsExpansionOn N]
    (hfunc : ExpandedFunctionsInReductClosure (L := L) (L' := L') (N := N))
    (e : M ↪[L] N) :
    ∃ (S : L'.Structure M), Bundled.mk M S ∈ K ∧
      (@Language.LHom.IsExpansionOn L L' φ M _ S) ∧
      ∃ (g : @Language.Embedding L' M N S T),
        ∀ x, (@Language.Embedding.toEmbedding L' M N S T g) x = e x := by
  let h := expandedRangeClosed_of_functionsInReductClosure hfunc e
  exact ⟨restrictFirstOrderExpansion e h,
    restrictFirstOrderExpansion_mem_of_hereditary hK hN e h,
    restrictFirstOrderExpansion_isExpansionOn φ e h,
    restrictFirstOrderExpansion_embedding e h, fun _ => rfl⟩

end SuccessorTree.NonPrecompact
