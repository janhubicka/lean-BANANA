import BANANA.NonPrecompact.FolkmanPersistence
import Mathlib.Data.Fintype.Card

/-!
# Finite tuple profiles for the non-unital Folkman atom presentation

For a tuple of elements in a finite Boolean ring, every ambient atom
has a membership signature in Fin n → Bool.  The *zero* signature is
outside the ring generated by the tuple: its atoms may be present in
the ambient ring, but no generator contains them.

The nonzero signatures index the generated ring's atoms, so there
are at most 2^n-1 of them, including n=0 and zero ambient rings.

For two sorts, we additionally record the induced F₂-pairing between
the fibres of each pair of nonzero signatures.  This gives a finite
profile type at every pair of tuple lengths, independently of the
number of ambient atoms.  This module does NOT claim that equal
profiles yield automorphic tuples of a Fraïssé limit.
-/

namespace SuccessorTree.NonPrecompact

open scoped Classical BigOperators

/-- The all-zero signature, omitted in a non-unital generated ring. -/
def folkmanZeroTuplePattern (n : ℕ) : Fin n → Bool :=
  fun _ => false

/-- Membership of an ambient ring atom in a tuple of ring elements. -/
def folkmanAtomTupleSignature
    {n atoms : ℕ}
    (xs : Fin n → Finset (Fin atoms)) (a : Fin atoms) :
    Fin n → Bool :=
  fun i => decide (a ∈ xs i)

theorem folkmanAtomTupleSignature_true_iff
    {n atoms : ℕ}
    (xs : Fin n → Finset (Fin atoms))
    (a : Fin atoms) (i : Fin n) :
    folkmanAtomTupleSignature xs a i = true ↔ a ∈ xs i := by
  simp [folkmanAtomTupleSignature]

/-- If an atom is present in a generator, its signature is nonzero. -/
theorem folkmanAtomTupleSignature_ne_zero_of_mem
    {n atoms : ℕ}
    (xs : Fin n → Finset (Fin atoms))
    (a : Fin atoms) (i : Fin n)
    (ha : a ∈ xs i) :
    folkmanAtomTupleSignature xs a ≠ folkmanZeroTuplePattern n := by
  intro h
  have hi := congrArg (fun p : Fin n → Bool => p i) h
  simp [folkmanAtomTupleSignature, folkmanZeroTuplePattern, ha] at hi

/-- Exactly the nonzero membership patterns realised by atoms.
The zero signature is deliberately removed, not counted as a
generated-ring atom. -/
noncomputable def folkmanTupleNonzeroPatterns
    {n atoms : ℕ} (xs : Fin n → Finset (Fin atoms)) :
    Finset (Fin n → Bool) := by
  classical
  exact ((Finset.univ : Finset (Fin atoms)).image
    (folkmanAtomTupleSignature xs)).filter
      (fun p => p ≠ folkmanZeroTuplePattern n)

/-- The correct non-unital bound is 2^n-1, not 2^n. -/
theorem folkmanTupleNonzeroPatterns_card_le
    {n atoms : ℕ} (xs : Fin n → Finset (Fin atoms)) :
    (folkmanTupleNonzeroPatterns xs).card ≤ 2 ^ n - 1 := by
  classical
  have hsubset :
      folkmanTupleNonzeroPatterns xs ⊆
        ((Finset.univ : Finset (Fin n → Bool)).erase
          (folkmanZeroTuplePattern n)) := by
    intro p hp
    have hne : p ≠ folkmanZeroTuplePattern n := by
      exact (Finset.mem_filter.mp hp).2
    exact Finset.mem_erase.mpr ⟨hne, Finset.mem_univ p⟩
  calc
    (folkmanTupleNonzeroPatterns xs).card ≤
        ((Finset.univ : Finset (Fin n → Bool)).erase
          (folkmanZeroTuplePattern n)).card :=
      Finset.card_le_card hsubset
    _ = 2 ^ n - 1 := by
      simp [Fintype.card_fun]

/-- Ambient atoms having one prescribed tuple-membership signature.
For a nonzero signature, this is a generated-ring atom block. -/
noncomputable def folkmanTuplePatternFiber
    {n atoms : ℕ}
    (xs : Fin n → Finset (Fin atoms))
    (p : Fin n → Bool) : Finset (Fin atoms) := by
  classical
  exact (Finset.univ : Finset (Fin atoms)).filter
    (fun a => folkmanAtomTupleSignature xs a = p)

/-- Parity of all ambient edges between the fibres of two patterns.
Patterns outside the generated non-unital subrings (the all-zero
ones) are explicitly ignored. -/
noncomputable def folkmanTuplePatternPairing
    (A : FolkmanAtomStructure)
    {nL nR : ℕ}
    (xs : Fin nL → Finset (Fin A.leftCount))
    (ys : Fin nR → Finset (Fin A.rightCount))
    (p : Fin nL → Bool) (q : Fin nR → Bool) : F2 := by
  classical
  exact if p = folkmanZeroTuplePattern nL ∨
      q = folkmanZeroTuplePattern nR then 0 else
    ∑ a ∈ folkmanTuplePatternFiber xs p,
      ∑ b ∈ folkmanTuplePatternFiber ys q, A.edge a b

/-- The profile never counts pairing values involving outside atoms. -/
theorem folkmanTuplePatternPairing_zero_left
    (A : FolkmanAtomStructure)
    {nL nR : ℕ}
    (xs : Fin nL → Finset (Fin A.leftCount))
    (ys : Fin nR → Finset (Fin A.rightCount))
    (q : Fin nR → Bool) :
    folkmanTuplePatternPairing A xs ys
      (folkmanZeroTuplePattern nL) q = 0 := by
  simp [folkmanTuplePatternPairing]

theorem folkmanTuplePatternPairing_zero_right
    (A : FolkmanAtomStructure)
    {nL nR : ℕ}
    (xs : Fin nL → Finset (Fin A.leftCount))
    (ys : Fin nR → Finset (Fin A.rightCount))
    (p : Fin nL → Bool) :
    folkmanTuplePatternPairing A xs ys
      p (folkmanZeroTuplePattern nR) = 0 := by
  simp [folkmanTuplePatternPairing]

/-- Nonzero left/right patterns and their induced cross-pairing.
The profile lives in a finite type determined only by tuple lengths. -/
abbrev FolkmanAtomTupleProfile (nL nR : ℕ) :=
  (Finset (Fin nL → Bool) × Finset (Fin nR → Bool)) ×
    ((Fin nL → Bool) → (Fin nR → Bool) → F2)

noncomputable def folkmanAtomTupleProfile
    (A : FolkmanAtomStructure)
    {nL nR : ℕ}
    (xs : Fin nL → Finset (Fin A.leftCount))
    (ys : Fin nR → Finset (Fin A.rightCount)) :
    FolkmanAtomTupleProfile nL nR :=
  ⟨⟨folkmanTupleNonzeroPatterns xs,
     folkmanTupleNonzeroPatterns ys⟩,
    folkmanTuplePatternPairing A xs ys⟩

/-- The finite combinatorial prerequisite for the Folkman oligomorphic
orbit argument. Actual orbit classification requires a homogeneous
countable limit and an extension theorem, not asserted here. -/
theorem folkmanAtomTupleProfileType_finite (nL nR : ℕ) :
    Finite (FolkmanAtomTupleProfile nL nR) := by
  infer_instance

end SuccessorTree.NonPrecompact
