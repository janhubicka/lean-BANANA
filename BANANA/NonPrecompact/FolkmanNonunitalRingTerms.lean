import BANANA.NonPrecompact.FolkmanTupleTermEquations
import Mathlib.Algebra.Ring.BooleanRing
import Mathlib.RingTheory.NonUnitalSubring.Basic

/-!
# Ring terms for the non-unital Folkman language

Only zero, generators, addition and multiplication occur in the syntax.
Negation needs no constructor in a Boolean ring because -x = x.
The closure theorem uses Mathlib's NonUnitalSubring.closure, not the
unital Subring.closure. No finiteness or nontriviality hypothesis is used.
-/

namespace SuccessorTree.NonPrecompact

open scoped Classical symmDiff

inductive FolkmanRingTerm (n : ℕ) : Type where
  | zero : FolkmanRingTerm n
  | generator : Fin n → FolkmanRingTerm n
  | add : FolkmanRingTerm n → FolkmanRingTerm n → FolkmanRingTerm n
  | mul : FolkmanRingTerm n → FolkmanRingTerm n → FolkmanRingTerm n

def FolkmanRingTerm.eval
    {n : ℕ} {α : Type*} [Zero α] [Add α] [Mul α]
    (xs : Fin n → α) : FolkmanRingTerm n → α
  | .zero => 0
  | .generator i => xs i
  | .add t u => t.eval xs + u.eval xs
  | .mul t u => t.eval xs * u.eval xs

def FolkmanRingTerm.evalSet
    {n atoms : ℕ} (xs : Fin n → Finset (Fin atoms)) :
    FolkmanRingTerm n → Finset (Fin atoms)
  | .zero => ∅
  | .generator i => xs i
  | .add t u => symmDiff (t.evalSet xs) (u.evalSet xs)
  | .mul t u => t.evalSet xs ∩ u.evalSet xs

def FolkmanRingTerm.evalPattern
    {n : ℕ} (p : Fin n → Bool) : FolkmanRingTerm n → Bool
  | .zero => false
  | .generator i => p i
  | .add t u => Bool.xor (t.evalPattern p) (u.evalPattern p)
  | .mul t u => t.evalPattern p && u.evalPattern p

/-- Ring terms do not acquire an ambient constant-one contribution. -/
theorem FolkmanRingTerm.evalPattern_zero
    {n : ℕ} (t : FolkmanRingTerm n) :
    t.evalPattern (folkmanZeroTuplePattern n) = false := by
  induction t with
  | zero => rfl
  | generator i => rfl
  | add t u iht ihu => simp [evalPattern, iht, ihu]
  | mul t u iht ihu => simp [evalPattern, iht, ihu]

/-- Membership in a ring-term value depends on the tuple signature. -/
theorem FolkmanRingTerm.mem_evalSet_iff
    {n atoms : ℕ} (xs : Fin n → Finset (Fin atoms))
    (a : Fin atoms) (t : FolkmanRingTerm n) :
    a ∈ t.evalSet xs ↔
      t.evalPattern (folkmanAtomTupleSignature xs a) = true := by
  induction t with
  | zero => simp [evalSet, evalPattern]
  | generator i =>
      exact (folkmanAtomTupleSignature_true_iff xs a i).symm
  | add t u iht ihu =>
      simp only [evalSet, Finset.mem_symmDiff, iht, ihu]
      cases ht : t.evalPattern (folkmanAtomTupleSignature xs a) <;>
        cases hu : u.evalPattern (folkmanAtomTupleSignature xs a) <;>
        simp [evalPattern, ht, hu]
  | mul t u iht ihu => simp [evalSet, evalPattern, iht, ihu]

/-- Finite-set evaluation is evaluation in the native powerset ring. -/
theorem FolkmanRingTerm.eval_toBoolRing
    {n atoms : ℕ} (xs : Fin n → Finset (Fin atoms))
    (t : FolkmanRingTerm n) :
    t.eval (fun i => toBoolRing (xs i)) = toBoolRing (t.evalSet xs) := by
  induction t with
  | zero => rfl
  | generator i => rfl
  | add t u iht ihu =>
      simpa only [eval, evalSet, toBoolRing_symmDiff] using
        congrArg₂ (fun x y : AsBoolRing (Finset (Fin atoms)) => x + y) iht ihu
  | mul t u iht ihu =>
      simpa only [eval, evalSet, toBoolRing_inf] using
        congrArg₂ (fun x y : AsBoolRing (Finset (Fin atoms)) => x * y) iht ihu

/-- This is the native non-unital subring generated by the tuple. -/
def folkmanGeneratedNonunitalSubring
    {n : ℕ} {α : Type*} [BooleanRing α] (xs : Fin n → α) :
    NonUnitalSubring α :=
  NonUnitalSubring.closure (Set.range xs)

/-- Every ring term evaluates in the native generated non-unital subring. -/
theorem FolkmanRingTerm.eval_mem_generated
    {n : ℕ} {α : Type*} [BooleanRing α]
    (xs : Fin n → α) (t : FolkmanRingTerm n) :
    t.eval xs ∈ folkmanGeneratedNonunitalSubring xs := by
  induction t with
  | zero => exact (folkmanGeneratedNonunitalSubring xs).zero_mem
  | generator i =>
      exact NonUnitalSubring.subset_closure (Set.mem_range_self i)
  | add t u iht ihu =>
      exact (folkmanGeneratedNonunitalSubring xs).add_mem iht ihu
  | mul t u iht ihu =>
      exact (folkmanGeneratedNonunitalSubring xs).mul_mem iht ihu

/-- Native closure is exactly the set of values of genuine ring terms.
This includes the empty tuple and the zero ring. -/
theorem folkmanGeneratedNonunitalSubring_mem_iff_ringTerm
    {n : ℕ} {α : Type*} [BooleanRing α]
    (xs : Fin n → α) (x : α) :
    x ∈ folkmanGeneratedNonunitalSubring xs ↔
      ∃ t : FolkmanRingTerm n, t.eval xs = x := by
  let R : NonUnitalSubring α := {
    carrier := {y | ∃ t : FolkmanRingTerm n, t.eval xs = y}
    zero_mem' := ⟨.zero, rfl⟩
    add_mem' := by
      rintro a b ⟨t, rfl⟩ ⟨u, rfl⟩
      exact ⟨.add t u, rfl⟩
    mul_mem' := by
      rintro a b ⟨t, rfl⟩ ⟨u, rfl⟩
      exact ⟨.mul t u, rfl⟩
    neg_mem' := by
      rintro a ⟨t, rfl⟩
      exact ⟨t, (BooleanRing.neg_eq (t.eval xs)).symm⟩
  }
  have hle : folkmanGeneratedNonunitalSubring xs ≤ R := by
    apply NonUnitalSubring.closure_le.mpr
    rintro a ⟨i, rfl⟩
    exact ⟨.generator i, rfl⟩
  constructor
  · intro hx
    exact hle hx
  · rintro ⟨t, rfl⟩
    exact t.eval_mem_generated xs

/-- No atom enumeration is needed for naturality of ring-term evaluation. -/
theorem FolkmanRingTerm.eval_map
    {n : ℕ} {α β : Type*} [Zero α] [Add α] [Mul α]
    [Zero β] [Add β] [Mul β]
    (f : α → β) (hzero : f 0 = 0)
    (hadd : ∀ x y, f (x + y) = f x + f y)
    (hmul : ∀ x y, f (x * y) = f x * f y)
    (xs : Fin n → α) (t : FolkmanRingTerm n) :
    f (t.eval xs) = t.eval (fun i => f (xs i)) := by
  induction t with
  | zero => exact hzero
  | generator i => rfl
  | add t u iht ihu => simp only [eval, hadd, iht, ihu]
  | mul t u iht ihu => simp only [eval, hmul, iht, ihu]

end SuccessorTree.NonPrecompact
